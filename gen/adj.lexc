! Handgeschriebener generativer FST — Adjektive (Positiv), drei Genera.
!
! Erweiterung des Nomen-Beispiels (gen/astem.lexc) auf Adjektive; teilt sich die
! Akzentregel gen/accent.regex. Wie bei den Nomen KEIN aus den Daten abgeleiteter
! Generator, sondern eine von Hand formulierte Hypothese, nicht-zirkulär gegen die
! Twanksta-Vollformen getestet.
!
! Zwei Klassen (vgl. Twanksta-paradigm):
!   AdjFixed  (Par. 25/27): fester Akzent — Stamm über alle 24 Formen stabil.
!   AdjMobile (Par. 26/29/31): bewegliche Betonung — in den akzentverschobenen
!             Slots wird der Stamm leicht (Makron kurz / Geminate einfach) und
!             die Endung schwer (ā, Gravis à, Geminate mm). Verschobene Slots:
!             Masc/Neut = Nom.Pl, Dat.Sg, Dat.Pl;  Fem = Nom.Sg, Dat.Pl.
!
! Mechanik wie bei den Nomen: die verschobenen Endungen stellen den abstrakten
! Akzentgrenze-Marker ^ voran; gen/accent.regex reduziert davor das schwere
! Stammmerkmal und tilgt ^. Der Auslöser ist der Marker, nicht die (schwere)
! Endung selbst — belarussisks (fest, mit Geminate ss) behält seine ss überall,
! weil kein ^ gesetzt wird.

Multichar_Symbols +A +V +PrsPrc +PrfPrc +Act +Pss +Adv +Comp +Superl +Msc +Fem +Neu +Sg +Pl +Nom +Gen +Dat +Acc ^ ~

LEXICON Root
  AdjFixed ;       ! Par.25 festes a-Stamm-Adjektiv
  AdjMobile ;      ! Par.26 mobiles a-Stamm-Adjektiv
  AdjI ;           ! Par.27 i-/jo-Stamm-Adjektiv (Masc/Neut jo, Fem i), fest
  AdjIMob ;        ! Par.29 mobiles i-Stamm-Adjektiv
  AdjUMob ;        ! Par.31 u-Stamm-Adjektiv (w-Gleitlaut), mobil
  PartPass ;       ! Par.69 passives Partizip
  PartAct ;        ! Par.68 aktives Partizip
  PartPres ;       ! Präsens-Partizip -nts (Stämme aus den Verb-Einträgen)
  AdjCmpStems ;    ! Komparativ-Stämme (i-/jo-Deklination, aus twanksta)
  AdjSupStems ;    ! Superlativ-Stämme (uka- + Komparativ-Stamm)
  AdvExcept ;      ! hand-gepflegte Adverb-Ausnahmen (Suppletiva, siehe unten)

! Hand-geschriebene Grammatik (nur Endungen, KEINE Wörter). LEXICON Root verweist
! auf AdjFixed/AdjMobile/PartPass/PartAct; der Build ersetzt den Root durch die
! Infl-Lexikone des jeweiligen Atoms (gen/atom_fst.py) — sonst bleibt die
! Wortliste in gen/*.lexc unberührt.

! Jedes Lexem verzweigt in alle drei Genera.
LEXICON AdjFixedInfl
  AdjFixedMasc ;
  AdjFixedFem ;
  AdjFixedNeut ;
  AdvA ;          ! Adverb positiv (a-Stamm)

LEXICON AdjMobileInfl
  AdjMobileMasc ;
  AdjMobileFem ;
  AdjMobileNeut ;
  AdvA ;          ! Adverb positiv (a-Stamm)

LEXICON AdjIInfl
  AdjIMasc ;
  AdjIFem ;
  AdjINeut ;
  AdvI ;          ! Adverb positiv (i-/jo-Stamm)

LEXICON AdjIMobInfl
  AdjIMobMasc ;
  AdjIMobFem ;
  AdjIMobNeut ;

LEXICON AdjUMobInfl
  AdjUMobMasc ;
  AdjUMobFem ;
  AdjUMobNeut ;
  AdvU ;          ! Adverb positiv (u-Stamm)

! ─── Feste Endungen (Par. 25) ──────────────────────────────────────────
LEXICON AdjFixedMasc
  +A+Msc+Sg+Nom:s       # ;
  +A+Msc+Pl+Nom:ai      # ;
  +A+Msc+Sg+Gen:as      # ;
  +A+Msc+Pl+Gen:an      # ;
  +A+Msc+Sg+Dat:asmu    # ;
  +A+Msc+Pl+Dat:amans   # ;
  +A+Msc+Sg+Acc:an      # ;
  +A+Msc+Pl+Acc:ans     # ;

LEXICON AdjFixedFem
  +A+Fem+Sg+Nom:a        # ;
  +A+Fem+Pl+Nom:as       # ;
  +A+Fem+Sg+Gen:as       # ;
  +A+Fem+Pl+Gen:an       # ;
  +A+Fem+Sg+Dat:ai       # ;
  +A+Fem+Pl+Dat:amans    # ;
  +A+Fem+Sg+Acc:an       # ;
  +A+Fem+Pl+Acc:ans      # ;

LEXICON AdjFixedNeut
  +A+Neu+Sg+Nom:an      # ;
  +A+Neu+Pl+Nom:ai      # ;
  +A+Neu+Sg+Gen:as      # ;
  +A+Neu+Pl+Gen:an      # ;
  +A+Neu+Sg+Dat:asmu    # ;
  +A+Neu+Pl+Dat:amans   # ;
  +A+Neu+Sg+Acc:an      # ;
  +A+Neu+Pl+Acc:ans     # ;

! ─── Mobile Endungen (Par. 26): ^ + schwere Endung in verschobenen Slots ──
LEXICON AdjMobileMasc
  +A+Msc+Sg+Nom:s        # ;
  +A+Msc+Pl+Nom:%^āi     # ;
  +A+Msc+Sg+Gen:as       # ;
  +A+Msc+Pl+Gen:an       # ;
  +A+Msc+Sg+Dat:%^àsmu   # ;
  +A+Msc+Pl+Dat:%^ammans # ;
  +A+Msc+Sg+Acc:an       # ;
  +A+Msc+Pl+Acc:ans      # ;

LEXICON AdjMobileFem
  +A+Fem+Sg+Nom:%^ā       # ;
  +A+Fem+Pl+Nom:as        # ;
  +A+Fem+Sg+Gen:as        # ;
  +A+Fem+Pl+Gen:an        # ;
  +A+Fem+Sg+Dat:ai        # ;
  +A+Fem+Pl+Dat:%^āmans   # ;
  +A+Fem+Sg+Acc:an        # ;
  +A+Fem+Pl+Acc:ans       # ;

LEXICON AdjMobileNeut
  +A+Neu+Sg+Nom:an       # ;
  +A+Neu+Pl+Nom:%^āi     # ;
  +A+Neu+Sg+Gen:as       # ;
  +A+Neu+Pl+Gen:an       # ;
  +A+Neu+Sg+Dat:%^àsmu   # ;
  +A+Neu+Pl+Dat:%^ammans # ;
  +A+Neu+Sg+Acc:an       # ;
  +A+Neu+Pl+Acc:ans      # ;

! ─── Par.27: i-/jo-Stamm-Adjektiv, fest (Masc/Neut jo-Endungen, Fem i-Endungen) ──
! Stamm = Masc.Gen.Sg. minus -jas (instrawingjas → instrawing). Kein ^: fester Akzent.
LEXICON AdjIMasc
  +A+Msc+Sg+Nom:is      # ;
  +A+Msc+Sg+Gen:jas     # ;
  +A+Msc+Sg+Dat:jasmu   # ;
  +A+Msc+Sg+Acc:jan     # ;
  +A+Msc+Pl+Nom:jai     # ;
  +A+Msc+Pl+Gen:jan     # ;
  +A+Msc+Pl+Dat:jamans  # ;
  +A+Msc+Pl+Acc:jans    # ;

LEXICON AdjIFem
  +A+Fem+Sg+Nom:i        # ;
  +A+Fem+Sg+Gen:is       # ;
  +A+Fem+Sg+Dat:ei       # ;
  +A+Fem+Sg+Acc:in       # ;
  +A+Fem+Pl+Nom:is       # ;
  +A+Fem+Pl+Gen:in       # ;
  +A+Fem+Pl+Dat:imans    # ;
  +A+Fem+Pl+Acc:ins      # ;

LEXICON AdjINeut
  +A+Neu+Sg+Nom:i       # ;
  +A+Neu+Sg+Gen:jas     # ;
  +A+Neu+Sg+Dat:jasmu   # ;
  +A+Neu+Sg+Acc:i       # ;
  +A+Neu+Pl+Nom:jai     # ;
  +A+Neu+Pl+Gen:jan     # ;
  +A+Neu+Pl+Dat:jamans  # ;
  +A+Neu+Pl+Acc:jans    # ;

! ─── Par.29: mobiles i-Stamm-Adjektiv ──────────────────────────────────────
! Stamm = Masc.Gen.Sg. minus -is (audijāntis → audijānt). Schwere Slots (^):
! Masc/Neut Dat.Pl -immans, Fem Nom.Sg -ī, Fem Dat.Pl -jāmans → Stamm leicht.
LEXICON AdjIMobMasc
  +A+Msc+Sg+Nom:s        # ;
  +A+Msc+Sg+Gen:is       # ;
  +A+Msc+Sg+Dat:ismu     # ;
  +A+Msc+Sg+Acc:in       # ;
  +A+Msc+Pl+Nom:jai      # ;
  +A+Msc+Pl+Gen:in       # ;
  +A+Msc+Pl+Dat:%^immans # ;
  +A+Msc+Pl+Acc:ins      # ;

LEXICON AdjIMobFem
  +A+Fem+Sg+Nom:%^ī       # ;
  +A+Fem+Sg+Gen:jas       # ;
  +A+Fem+Sg+Dat:jai       # ;
  +A+Fem+Sg+Acc:jan       # ;
  +A+Fem+Pl+Nom:jas       # ;
  +A+Fem+Pl+Gen:jan       # ;
  +A+Fem+Pl+Dat:%^jāmans  # ;
  +A+Fem+Pl+Acc:jans      # ;

LEXICON AdjIMobNeut
  +A+Neu+Sg+Nom:i        # ;
  +A+Neu+Sg+Gen:is       # ;
  +A+Neu+Sg+Dat:ismu     # ;
  +A+Neu+Sg+Acc:i        # ;
  +A+Neu+Pl+Nom:jai      # ;
  +A+Neu+Pl+Gen:in       # ;
  +A+Neu+Pl+Dat:%^immans # ;
  +A+Neu+Pl+Acc:ins      # ;

! ─── Par.31: u-Stamm-Adjektiv (w-Gleitlaut), mobil ─────────────────────────
! Stamm = Masc.Nom.Sg. minus -us (preilāngus → preilāng; der Nom.Sg. trägt den
! Grundakzent). Schwere Slots (^): die w-Formen -was/-wāi, Dat.Pl -ummans, Fem
! Nom.Sg -ī, Fem Dat.Pl -jāmans → Stamm leicht (preilāng+^wāi → preilangwāi).
LEXICON AdjUMobMasc
  +A+Msc+Sg+Nom:us       # ;
  +A+Msc+Sg+Gen:%^was    # ;
  +A+Msc+Sg+Dat:usmu     # ;
  +A+Msc+Sg+Acc:un       # ;
  +A+Msc+Pl+Nom:%^wāi    # ;
  +A+Msc+Pl+Gen:un       # ;
  +A+Msc+Pl+Dat:%^ummans # ;
  +A+Msc+Pl+Acc:uns      # ;

LEXICON AdjUMobFem
  +A+Fem+Sg+Nom:%^ī       # ;
  +A+Fem+Sg+Gen:jas       # ;
  +A+Fem+Sg+Dat:jai       # ;
  +A+Fem+Sg+Acc:jan       # ;
  +A+Fem+Pl+Nom:jas       # ;
  +A+Fem+Pl+Gen:jan       # ;
  +A+Fem+Pl+Dat:%^jāmans  # ;
  +A+Fem+Pl+Acc:jans      # ;

LEXICON AdjUMobNeut
  +A+Neu+Sg+Nom:u        # ;
  +A+Neu+Sg+Gen:%^was    # ;
  +A+Neu+Sg+Dat:usmu     # ;
  +A+Neu+Sg+Acc:u        # ;
  +A+Neu+Pl+Nom:%^wāi    # ;
  +A+Neu+Pl+Gen:un       # ;
  +A+Neu+Pl+Dat:%^ummans # ;
  +A+Neu+Pl+Acc:uns      # ;

! ═══ PARTIZIPIEN (agieren adjektivisch, drei Genera) ══════════════════════
!
! Twanksta-Par.68/69 sind KEINE Nomen, sondern Partizipien mit adjektivischer
! Deklination (Dat.Sg. -asmu/-jasmu, drei Genusblöcke). Zwei Typen:
!   PartPass (Par.69): passives Partizip -ts, a-stämmig, semi-mobil. Wie das
!            mobile Adjektiv, aber Dat.Sg. -asmu ist NICHT mobil (kein Gravis),
!            und Neut Nom.Pl. -āi bleibt fest. Mobile Slots: Masc Nom.Pl/Dat.Pl,
!            Fem Nom.Sg/Dat.Pl, Neut Dat.Pl. Stamm = Masc.Gen.Sg. minus -as.
!   PartAct  (Par.68): aktives Partizip -uns, eigener -us-Stamm, fest. Masc -uns,
!            Fem -usi, Neut -us; obliquer -us- + jo-artige Endungen (-jas/-jasmu/
!            -jai/-jamans). Stamm = Masc.Nom.Sg. minus -uns.

LEXICON PartPassInfl
  PartPassMasc ;
  PartPassFem ;
  PartPassNeut ;

LEXICON PartActInfl
  PartActMasc ;
  PartActFem ;
  PartActNeut ;

! ─── Passives Partizip -ts (Par.69), a-stämmig, semi-mobil ────────────────
LEXICON PartPassMasc
  +V+PrfPrc+Pss+Msc+Sg+Nom:s        # ;
  +V+PrfPrc+Pss+Msc+Pl+Nom:%^āi     # ;   ! mobil
  +V+PrfPrc+Pss+Msc+Sg+Gen:as       # ;
  +V+PrfPrc+Pss+Msc+Pl+Gen:an       # ;
  +V+PrfPrc+Pss+Msc+Sg+Dat:asmu     # ;   ! nicht mobil (anders als Adj-Mobil)
  +V+PrfPrc+Pss+Msc+Pl+Dat:%^ammans # ;   ! mobil
  +V+PrfPrc+Pss+Msc+Sg+Acc:an       # ;
  +V+PrfPrc+Pss+Msc+Pl+Acc:ans      # ;

LEXICON PartPassFem
  +V+PrfPrc+Pss+Fem+Sg+Nom:%^ā       # ;   ! mobil
  +V+PrfPrc+Pss+Fem+Pl+Nom:as        # ;
  +V+PrfPrc+Pss+Fem+Sg+Gen:as        # ;
  +V+PrfPrc+Pss+Fem+Pl+Gen:an        # ;
  +V+PrfPrc+Pss+Fem+Sg+Dat:ai        # ;
  +V+PrfPrc+Pss+Fem+Pl+Dat:%^āmans   # ;   ! mobil
  +V+PrfPrc+Pss+Fem+Sg+Acc:an        # ;
  +V+PrfPrc+Pss+Fem+Pl+Acc:ans       # ;

LEXICON PartPassNeut
  +V+PrfPrc+Pss+Neu+Sg+Nom:an       # ;
  +V+PrfPrc+Pss+Neu+Pl+Nom:āi       # ;   ! fest (anders als Masc)
  +V+PrfPrc+Pss+Neu+Sg+Gen:as       # ;
  +V+PrfPrc+Pss+Neu+Pl+Gen:an       # ;
  +V+PrfPrc+Pss+Neu+Sg+Dat:asmu     # ;
  +V+PrfPrc+Pss+Neu+Pl+Dat:%^ammans # ;   ! mobil
  +V+PrfPrc+Pss+Neu+Sg+Acc:an       # ;
  +V+PrfPrc+Pss+Neu+Pl+Acc:ans      # ;

! ─── Aktives Partizip -uns (Par.68), -us-Stamm, fest ──────────────────────
LEXICON PartActMasc
  +V+PrfPrc+Act+Msc+Sg+Nom:uns       # ;
  +V+PrfPrc+Act+Msc+Pl+Nom:usis      # ;
  +V+PrfPrc+Act+Msc+Sg+Gen:usjas     # ;
  +V+PrfPrc+Act+Msc+Pl+Gen:usin      # ;
  +V+PrfPrc+Act+Msc+Sg+Dat:usjasmu   # ;
  +V+PrfPrc+Act+Msc+Pl+Dat:usimans   # ;
  +V+PrfPrc+Act+Msc+Sg+Acc:usin      # ;
  +V+PrfPrc+Act+Msc+Pl+Acc:usins     # ;

LEXICON PartActFem
  +V+PrfPrc+Act+Fem+Sg+Nom:usi        # ;
  +V+PrfPrc+Act+Fem+Pl+Nom:usjas      # ;
  +V+PrfPrc+Act+Fem+Sg+Gen:usjas      # ;
  +V+PrfPrc+Act+Fem+Pl+Gen:usjan      # ;
  +V+PrfPrc+Act+Fem+Sg+Dat:usjai      # ;
  +V+PrfPrc+Act+Fem+Pl+Dat:usjamans   # ;
  +V+PrfPrc+Act+Fem+Sg+Acc:usin       # ;
  +V+PrfPrc+Act+Fem+Pl+Acc:usjans     # ;

LEXICON PartActNeut
  +V+PrfPrc+Act+Neu+Sg+Nom:us        # ;
  +V+PrfPrc+Act+Neu+Pl+Nom:us        # ;
  +V+PrfPrc+Act+Neu+Sg+Gen:usjas     # ;
  +V+PrfPrc+Act+Neu+Pl+Gen:usin      # ;
  +V+PrfPrc+Act+Neu+Sg+Dat:usjasmu   # ;
  +V+PrfPrc+Act+Neu+Pl+Dat:usimans   # ;
  +V+PrfPrc+Act+Neu+Sg+Acc:us        # ;
  +V+PrfPrc+Act+Neu+Pl+Acc:us        # ;

! ─── Präsens-Partizip -nts (mobiles i-Stamm-Muster, drei Genera) ──────────
! Das Präsens-Partizip deklinert wie Par.29 (mobiles i-Stamm-Adjektiv): schwere
! Slots (^) Masc/Neut Dat.Pl -immans, Fem Nom.Sg -ī, Fem Dat.Pl -jāmans → Stamm
! leicht (makron-/geminatenlos). Eine Abweichung vom Par.29-Neutrum: der
! Ntr.Acc.Sg. ist -in (nicht -i) — entspricht dem Maskulinum.
!
! Geteilte Mobilität (anders als Par.29): das Fem-Nom.Sg. -ī trägt ZUSÄTZLICH den
! Schutzmarker ~ (→ %~%^ī) — es kürzt das Stamm-Makron (Shorten), reduziert aber
! NICHT die Stamm-Gemination (Degem gesperrt). Beleg: adressītwei → adressintī
! (ss bleibt), aber Dat.Pl. adresintimmans (ss→s). Der Dat.Pl. (^immans/^jāmans)
! bleibt voll mobil (Shorten + Degem).
!
! Stämme kommen aus den VERB-Einträgen (forms.participles[type=Present].
! full_declension), nicht aus Adjektiven: Stamm = Masc.Gen.Sg. minus -is
! (kalbantis → kalbant). Das Tag-Format ist kanonisch V+Part+Pres (wie base.gen).
! Eine Handvoll Verben (jj/cc-Gemination: auswajjintun, buccautun, …) behält die
! Geminate auch im Dat.Pl. — gelistet in LEXICON PartPresGemKeep, Stamm + ~.
LEXICON PartPresInfl
  PartPresMasc ;
  PartPresFem ;
  PartPresNeut ;

LEXICON PartPresMasc
  +V+PrsPrc+Act+Msc+Sg+Nom:s        # ;
  +V+PrsPrc+Act+Msc+Sg+Gen:is       # ;
  +V+PrsPrc+Act+Msc+Sg+Dat:ismu     # ;
  +V+PrsPrc+Act+Msc+Sg+Acc:in       # ;
  +V+PrsPrc+Act+Msc+Pl+Nom:jai      # ;
  +V+PrsPrc+Act+Msc+Pl+Gen:in       # ;
  +V+PrsPrc+Act+Msc+Pl+Dat:%^immans # ;
  +V+PrsPrc+Act+Msc+Pl+Acc:ins      # ;

LEXICON PartPresFem
  +V+PrsPrc+Act+Fem+Sg+Nom:%~%^ī     # ;
  +V+PrsPrc+Act+Fem+Sg+Gen:jas       # ;
  +V+PrsPrc+Act+Fem+Sg+Dat:jai       # ;
  +V+PrsPrc+Act+Fem+Sg+Acc:jan       # ;
  +V+PrsPrc+Act+Fem+Pl+Nom:jas       # ;
  +V+PrsPrc+Act+Fem+Pl+Gen:jan       # ;
  +V+PrsPrc+Act+Fem+Pl+Dat:%^jāmans  # ;
  +V+PrsPrc+Act+Fem+Pl+Acc:jans      # ;

LEXICON PartPresNeut
  +V+PrsPrc+Act+Neu+Sg+Nom:i        # ;
  +V+PrsPrc+Act+Neu+Sg+Gen:is       # ;
  +V+PrsPrc+Act+Neu+Sg+Dat:ismu     # ;
  +V+PrsPrc+Act+Neu+Sg+Acc:in       # ;
  +V+PrsPrc+Act+Neu+Pl+Nom:jai      # ;
  +V+PrsPrc+Act+Neu+Pl+Gen:in       # ;
  +V+PrsPrc+Act+Neu+Pl+Dat:%^immans # ;
  +V+PrsPrc+Act+Neu+Pl+Acc:ins      # ;

! ===========================================================================
! LEXICON PartPresGemKeep — lexikalische (baked-in) Stamm-Gemination im Dat.Pl.
! ===========================================================================
! Diese Verben behalten ihre Stamm-Gemination (jj/cc = palataler/affrikater
! Doppelkonsonant) auch im akzentverschobenen Dat.Pl. -immans/-jāmans, während
! die übrigen Geminaten-Verben dort degeminieren (adressints → adresintimmans).
! Der Schutzmarker ~ steht hier bereits am Stamm; gen/accent.regex sperrt
! daraufhin die Degemination. NICHT von LEXICON Root referenziert — reine
! Ausnahmeliste (nur Lemma-Quelle).
LEXICON PartPresGemKeep
  auswajjintun+V+PrsPrc+Act+Msc+Sg+Nom:auswajjintun     # ;
  bajjintun+V+PrsPrc+Act+Msc+Sg+Nom:bajjintun           # ;
  pabajjintun+V+PrsPrc+Act+Msc+Sg+Nom:pabajjintun       # ;
  dwejjintun+V+PrsPrc+Act+Msc+Sg+Nom:dwejjintun         # ;
  enskajjintun+V+PrsPrc+Act+Msc+Sg+Nom:enskajjintun     # ;
  enswajjintun+V+PrsPrc+Act+Msc+Sg+Nom:enswajjintun     # ;
  etskajjintun+V+PrsPrc+Act+Msc+Sg+Nom:etskajjintun     # ;
  izskajjintun+V+PrsPrc+Act+Msc+Sg+Nom:izskajjintun     # ;
  lejjintun+V+PrsPrc+Act+Msc+Sg+Nom:lejjintun            # ;
  perskajjintun+V+PrsPrc+Act+Msc+Sg+Nom:perskajjintun   # ;
  praskajjintun+V+PrsPrc+Act+Msc+Sg+Nom:praskajjintun   # ;
  skajjintun+V+PrsPrc+Act+Msc+Sg+Nom:skajjintun         # ;
  buccautun+V+PrsPrc+Act+Msc+Sg+Nom:buccautun           # ;
  enšpriccintun+V+PrsPrc+Act+Msc+Sg+Nom:enšpriccintun   # ;
  špriccintun+V+PrsPrc+Act+Msc+Sg+Nom:špriccintun       # ;

! ═══════════════════════════════════════════════════════════════════════════
! ADVERBIEN — Gradtafel (Positiv/Komparativ/Superlativ), je EINE Form.
!
! Twanksta `forms.adverb` = {positive, comparative, superlative}. Die Bildung ist
! regelhaft (an twanksta verifiziert, n=1019):
!   Positiv    = Adjektivstamm + Klassensuffix: -ai (a-Stamm Par.25/26),
!                -jai (i-/jo-Stamm Par.27), -u (u-Stamm Par.30/31).
!   Komparativ = Positiv + -s (a-/i-/jo-Stamm: -ais/-jais), u-Stamm -uis.
!   Superlativ = uka- + Komparativ (100 % regelhaft) → uka-Komparativ-Stamm.
!
! Architektur: der Positiv hängt am selben (Adjektiv-)Stamm und wird über die
! Adv{A,I,U}-Endungslexika am Klassen-Infl erzeugt. Komparativ und Superlativ
! teilen sich mit dem Adjektiv (Phase 2) die i-/jo-Deklination: der Komparativ-
! Stamm (AdjCmpStems) und der Superlativ-Stamm (AdjSupStems = "uka"+Komparativ-
! Stamm) werden je einmal aus twanksta emittiert; das Adverb nutzt dieselben
! Stämme mit leerer Endung (+Adv+Comp/+Adv+Superl), das Adjektiv dieselben Stämme
! mit der i-/jo-Endungstabelle. Die uka-Präfix-Mechanik ist also EINMAL gebaut.
! ═══════════════════════════════════════════════════════════════════════════

LEXICON AdvA
  +Adv:ai   # ;

LEXICON AdvI
  +Adv:jai  # ;

LEXICON AdvU
  +Adv:u    # ;

! ─── Komparativ/Superlativ: gemeinsame i-/jo-Deklination (fix, kein ^) ─────
! Der Stamm (AdjCmpStems/AdjSupStems) trägt schon den Grad (-ais/-jais/-uis bzw.
! uka+…); hier nur die Endungen. Aufbau wie Par.27 (jo-Stamm, Masc/Neut) mit
! Fem-i-Deklination, jedoch Gen.Pl./Dat.Pl. obliqu -in/-imans (eigenes Muster).

LEXICON AdjCmpInfl
  AdvCmp ;
  AdjCmpMasc ;
  AdjCmpFem ;
  AdjCmpNeut ;

LEXICON AdjSupInfl
  AdvSup ;
  AdjSupMasc ;
  AdjSupFem ;
  AdjSupNeut ;

LEXICON AdvCmp
  +Adv+Comp:0  # ;

LEXICON AdvSup
  +Adv+Superl:0  # ;

LEXICON AdjCmpMasc
  +A+Comp+Msc+Sg+Nom:is     # ;
  +A+Comp+Msc+Sg+Gen:jas    # ;
  +A+Comp+Msc+Sg+Dat:jasmu  # ;
  +A+Comp+Msc+Sg+Acc:in     # ;
  +A+Comp+Msc+Pl+Nom:jai    # ;
  +A+Comp+Msc+Pl+Gen:in     # ;
  +A+Comp+Msc+Pl+Dat:imans  # ;
  +A+Comp+Msc+Pl+Acc:ins    # ;

LEXICON AdjCmpFem
  +A+Comp+Fem+Sg+Nom:i       # ;
  +A+Comp+Fem+Sg+Gen:jas     # ;
  +A+Comp+Fem+Sg+Dat:jai     # ;
  +A+Comp+Fem+Sg+Acc:jan     # ;
  +A+Comp+Fem+Pl+Nom:jas     # ;
  +A+Comp+Fem+Pl+Gen:jan     # ;
  +A+Comp+Fem+Pl+Dat:jamans  # ;
  +A+Comp+Fem+Pl+Acc:jans    # ;

LEXICON AdjCmpNeut
  +A+Comp+Neu+Sg+Nom:i      # ;
  +A+Comp+Neu+Sg+Gen:jas    # ;
  +A+Comp+Neu+Sg+Dat:jasmu  # ;
  +A+Comp+Neu+Sg+Acc:i      # ;
  +A+Comp+Neu+Pl+Nom:jai    # ;
  +A+Comp+Neu+Pl+Gen:in     # ;
  +A+Comp+Neu+Pl+Dat:imans  # ;
  +A+Comp+Neu+Pl+Acc:ins    # ;

LEXICON AdjSupMasc
  +A+Superl+Msc+Sg+Nom:is     # ;
  +A+Superl+Msc+Sg+Gen:jas    # ;
  +A+Superl+Msc+Sg+Dat:jasmu  # ;
  +A+Superl+Msc+Sg+Acc:in     # ;
  +A+Superl+Msc+Pl+Nom:jai    # ;
  +A+Superl+Msc+Pl+Gen:in     # ;
  +A+Superl+Msc+Pl+Dat:imans  # ;
  +A+Superl+Msc+Pl+Acc:ins    # ;

LEXICON AdjSupFem
  +A+Superl+Fem+Sg+Nom:i       # ;
  +A+Superl+Fem+Sg+Gen:jas     # ;
  +A+Superl+Fem+Sg+Dat:jai     # ;
  +A+Superl+Fem+Sg+Acc:jan     # ;
  +A+Superl+Fem+Pl+Nom:jas     # ;
  +A+Superl+Fem+Pl+Gen:jan     # ;
  +A+Superl+Fem+Pl+Dat:jamans  # ;
  +A+Superl+Fem+Pl+Acc:jans    # ;

LEXICON AdjSupNeut
  +A+Superl+Neu+Sg+Nom:i      # ;
  +A+Superl+Neu+Sg+Gen:jas    # ;
  +A+Superl+Neu+Sg+Dat:jasmu  # ;
  +A+Superl+Neu+Sg+Acc:i      # ;
  +A+Superl+Neu+Pl+Nom:jai    # ;
  +A+Superl+Neu+Pl+Gen:in     # ;
  +A+Superl+Neu+Pl+Dat:imans  # ;
  +A+Superl+Neu+Pl+Acc:ins    # ;

! ===========================================================================
! LEXICON AdvExcept — hand-gepflegte Adverb-Ausnahmen (regelloser Rest)
! ===========================================================================
! Suppletion (labs→walnai, līkuts→mazzan, debīks→tūlan) und Stamm-Irregularität
! (Geminat-/Stamm-Wahrung: dabbars, timmars, tikkars; auktums, seks) sind per
! Definition regellos und MÜSSEN gelistet werden — als fertige Gradformen, NICHT
! als Regel. Die Formen stehen hier als Mini-LUT für genau den regellosen Rest.
LEXICON AdvExcept
  ! Suppletiva
  labs+Adv:labbai                  # ;
  labs+Adv+Comp:walnai              # ;
  labs+Adv+Superl:ukawalnai           # ;
  līkuts+Adv:mazzan                # ;
  līkuts+Adv+Comp:mazzais           # ;
  līkuts+Adv+Superl:ukamazzais        # ;
  debīks+Adv:tūlan                 # ;
  debīks+Adv+Comp:tūls              # ;
  debīks+Adv+Superl:ukatūls           # ;
  ! Stamm-Irregularität (Geminat wahrung / abweichender Stamm)
  dabbars+Adv:dabbrai              # ;
  dabbars+Adv+Comp:dabbrais         # ;
  dabbars+Adv+Superl:ukadabbrais      # ;
  timmars+Adv:timmrai              # ;
  timmars+Adv+Comp:timmrais         # ;
  timmars+Adv+Superl:ukatimmrais      # ;
  tikkars+Adv:tikkrai              # ;
  tikkars+Adv+Comp:tikkrais         # ;
  tikkars+Adv+Superl:ukatikkrais      # ;
  auktums+Adv:auktumai             # ;
  auktums+Adv+Comp:auktumais        # ;
  auktums+Adv+Superl:ukaauktumais     # ;
  seks+Adv:sekku                   # ;
  seks+Adv+Comp:sekkuis             # ;
  seks+Adv+Superl:ukasekkuis          # ;

! Handgeschriebener generativer FST — Adjektive (Positiv), drei Genera.
!
! Erweiterung des Nomen-Beispiels (gen/astem.lexc) auf Adjektive; teilt sich die
! Akzentregel gen/accent.regex. Wie bei den Nomen KEIN aus den Daten abgeleiteter
! Generator, sondern eine von Hand formulierte Hypothese, nicht-zirkulär gegen die
! Twanksta-Vollformen getestet.
!
! Zwei Klassen (vgl. Twanksta-paradigm):
!   AdjFixed  (Par. 25/27): fester Akzent — Stamm über alle 24 Formen stabil.
!   AdjMobile (Par. 26/29/31): bewegliche Betonung — in den akzentverschobenen
!             Slots wird der Stamm leicht (Makron kurz / Geminate einfach) und
!             die Endung schwer (ā, Gravis à, Geminate mm). Verschobene Slots:
!             Masc/Neut = Nom.Pl, Dat.Sg, Dat.Pl;  Fem = Nom.Sg, Dat.Pl.
!
! Mechanik wie bei den Nomen: die verschobenen Endungen stellen den abstrakten
! Akzentgrenze-Marker ^ voran; gen/accent.regex reduziert davor das schwere
! Stammmerkmal und tilgt ^. Der Auslöser ist der Marker, nicht die (schwere)
! Endung selbst — belarussisks (fest, mit Geminate ss) behält seine ss überall,
! weil kein ^ gesetzt wird.

Multichar_Symbols +Adj +Part +Pass +Past +Masc +Fem +Neut +Sg +Pl +Nom +Gen +Dat +Acc ^

LEXICON Root
  AdjFixed ;       ! Par.25 festes a-Stamm-Adjektiv
  AdjMobile ;      ! Par.26 mobiles a-Stamm-Adjektiv
  AdjI ;           ! Par.27 i-/jo-Stamm-Adjektiv (Masc/Neut jo, Fem i), fest
  AdjIMob ;        ! Par.29 mobiles i-Stamm-Adjektiv
  AdjUMob ;        ! Par.31 u-Stamm-Adjektiv (w-Gleitlaut), mobil
  PartPass ;       ! Par.69 passives Partizip
  PartAct ;        ! Par.68 aktives Partizip

! Hand-geschriebene Grammatik (nur Endungen, KEINE Wörter). LEXICON Root verweist
! auf AdjFixed/AdjMobile/PartPass/PartAct; deren Einträge (Lemma:Stamm  …Infl ;)
! kommen aus twanksta, der Build hängt sie an (siehe Makefile):
!   uv run python gen/coverage_adj.py --emit-stems build/gen-adj-stems.lexc

! Jedes Lexem verzweigt in alle drei Genera.
LEXICON AdjFixedInfl
  AdjFixedMasc ;
  AdjFixedFem ;
  AdjFixedNeut ;

LEXICON AdjMobileInfl
  AdjMobileMasc ;
  AdjMobileFem ;
  AdjMobileNeut ;

LEXICON AdjIInfl
  AdjIMasc ;
  AdjIFem ;
  AdjINeut ;

LEXICON AdjIMobInfl
  AdjIMobMasc ;
  AdjIMobFem ;
  AdjIMobNeut ;

LEXICON AdjUMobInfl
  AdjUMobMasc ;
  AdjUMobFem ;
  AdjUMobNeut ;

! ─── Feste Endungen (Par. 25) ──────────────────────────────────────────
LEXICON AdjFixedMasc
  +Adj+Masc+Sg+Nom:s       # ;
  +Adj+Masc+Pl+Nom:ai      # ;
  +Adj+Masc+Sg+Gen:as      # ;
  +Adj+Masc+Pl+Gen:an      # ;
  +Adj+Masc+Sg+Dat:asmu    # ;
  +Adj+Masc+Pl+Dat:amans   # ;
  +Adj+Masc+Sg+Acc:an      # ;
  +Adj+Masc+Pl+Acc:ans     # ;

LEXICON AdjFixedFem
  +Adj+Fem+Sg+Nom:a        # ;
  +Adj+Fem+Pl+Nom:as       # ;
  +Adj+Fem+Sg+Gen:as       # ;
  +Adj+Fem+Pl+Gen:an       # ;
  +Adj+Fem+Sg+Dat:ai       # ;
  +Adj+Fem+Pl+Dat:amans    # ;
  +Adj+Fem+Sg+Acc:an       # ;
  +Adj+Fem+Pl+Acc:ans      # ;

LEXICON AdjFixedNeut
  +Adj+Neut+Sg+Nom:an      # ;
  +Adj+Neut+Pl+Nom:ai      # ;
  +Adj+Neut+Sg+Gen:as      # ;
  +Adj+Neut+Pl+Gen:an      # ;
  +Adj+Neut+Sg+Dat:asmu    # ;
  +Adj+Neut+Pl+Dat:amans   # ;
  +Adj+Neut+Sg+Acc:an      # ;
  +Adj+Neut+Pl+Acc:ans     # ;

! ─── Mobile Endungen (Par. 26): ^ + schwere Endung in verschobenen Slots ──
LEXICON AdjMobileMasc
  +Adj+Masc+Sg+Nom:s        # ;
  +Adj+Masc+Pl+Nom:%^āi     # ;
  +Adj+Masc+Sg+Gen:as       # ;
  +Adj+Masc+Pl+Gen:an       # ;
  +Adj+Masc+Sg+Dat:%^àsmu   # ;
  +Adj+Masc+Pl+Dat:%^ammans # ;
  +Adj+Masc+Sg+Acc:an       # ;
  +Adj+Masc+Pl+Acc:ans      # ;

LEXICON AdjMobileFem
  +Adj+Fem+Sg+Nom:%^ā       # ;
  +Adj+Fem+Pl+Nom:as        # ;
  +Adj+Fem+Sg+Gen:as        # ;
  +Adj+Fem+Pl+Gen:an        # ;
  +Adj+Fem+Sg+Dat:ai        # ;
  +Adj+Fem+Pl+Dat:%^āmans   # ;
  +Adj+Fem+Sg+Acc:an        # ;
  +Adj+Fem+Pl+Acc:ans       # ;

LEXICON AdjMobileNeut
  +Adj+Neut+Sg+Nom:an       # ;
  +Adj+Neut+Pl+Nom:%^āi     # ;
  +Adj+Neut+Sg+Gen:as       # ;
  +Adj+Neut+Pl+Gen:an       # ;
  +Adj+Neut+Sg+Dat:%^àsmu   # ;
  +Adj+Neut+Pl+Dat:%^ammans # ;
  +Adj+Neut+Sg+Acc:an       # ;
  +Adj+Neut+Pl+Acc:ans      # ;

! ─── Par.27: i-/jo-Stamm-Adjektiv, fest (Masc/Neut jo-Endungen, Fem i-Endungen) ──
! Stamm = Masc.Gen.Sg. minus -jas (instrawingjas → instrawing). Kein ^: fester Akzent.
LEXICON AdjIMasc
  +Adj+Masc+Sg+Nom:is      # ;
  +Adj+Masc+Sg+Gen:jas     # ;
  +Adj+Masc+Sg+Dat:jasmu   # ;
  +Adj+Masc+Sg+Acc:jan     # ;
  +Adj+Masc+Pl+Nom:jai     # ;
  +Adj+Masc+Pl+Gen:jan     # ;
  +Adj+Masc+Pl+Dat:jamans  # ;
  +Adj+Masc+Pl+Acc:jans    # ;

LEXICON AdjIFem
  +Adj+Fem+Sg+Nom:i        # ;
  +Adj+Fem+Sg+Gen:is       # ;
  +Adj+Fem+Sg+Dat:ei       # ;
  +Adj+Fem+Sg+Acc:in       # ;
  +Adj+Fem+Pl+Nom:is       # ;
  +Adj+Fem+Pl+Gen:in       # ;
  +Adj+Fem+Pl+Dat:imans    # ;
  +Adj+Fem+Pl+Acc:ins      # ;

LEXICON AdjINeut
  +Adj+Neut+Sg+Nom:i       # ;
  +Adj+Neut+Sg+Gen:jas     # ;
  +Adj+Neut+Sg+Dat:jasmu   # ;
  +Adj+Neut+Sg+Acc:i       # ;
  +Adj+Neut+Pl+Nom:jai     # ;
  +Adj+Neut+Pl+Gen:jan     # ;
  +Adj+Neut+Pl+Dat:jamans  # ;
  +Adj+Neut+Pl+Acc:jans    # ;

! ─── Par.29: mobiles i-Stamm-Adjektiv ──────────────────────────────────────
! Stamm = Masc.Gen.Sg. minus -is (audijāntis → audijānt). Schwere Slots (^):
! Masc/Neut Dat.Pl -immans, Fem Nom.Sg -ī, Fem Dat.Pl -jāmans → Stamm leicht.
LEXICON AdjIMobMasc
  +Adj+Masc+Sg+Nom:s        # ;
  +Adj+Masc+Sg+Gen:is       # ;
  +Adj+Masc+Sg+Dat:ismu     # ;
  +Adj+Masc+Sg+Acc:in       # ;
  +Adj+Masc+Pl+Nom:jai      # ;
  +Adj+Masc+Pl+Gen:in       # ;
  +Adj+Masc+Pl+Dat:%^immans # ;
  +Adj+Masc+Pl+Acc:ins      # ;

LEXICON AdjIMobFem
  +Adj+Fem+Sg+Nom:%^ī       # ;
  +Adj+Fem+Sg+Gen:jas       # ;
  +Adj+Fem+Sg+Dat:jai       # ;
  +Adj+Fem+Sg+Acc:jan       # ;
  +Adj+Fem+Pl+Nom:jas       # ;
  +Adj+Fem+Pl+Gen:jan       # ;
  +Adj+Fem+Pl+Dat:%^jāmans  # ;
  +Adj+Fem+Pl+Acc:jans      # ;

LEXICON AdjIMobNeut
  +Adj+Neut+Sg+Nom:i        # ;
  +Adj+Neut+Sg+Gen:is       # ;
  +Adj+Neut+Sg+Dat:ismu     # ;
  +Adj+Neut+Sg+Acc:i        # ;
  +Adj+Neut+Pl+Nom:jai      # ;
  +Adj+Neut+Pl+Gen:in       # ;
  +Adj+Neut+Pl+Dat:%^immans # ;
  +Adj+Neut+Pl+Acc:ins      # ;

! ─── Par.31: u-Stamm-Adjektiv (w-Gleitlaut), mobil ─────────────────────────
! Stamm = Masc.Nom.Sg. minus -us (preilāngus → preilāng; der Nom.Sg. trägt den
! Grundakzent). Schwere Slots (^): die w-Formen -was/-wāi, Dat.Pl -ummans, Fem
! Nom.Sg -ī, Fem Dat.Pl -jāmans → Stamm leicht (preilāng+^wāi → preilangwāi).
LEXICON AdjUMobMasc
  +Adj+Masc+Sg+Nom:us       # ;
  +Adj+Masc+Sg+Gen:%^was    # ;
  +Adj+Masc+Sg+Dat:usmu     # ;
  +Adj+Masc+Sg+Acc:un       # ;
  +Adj+Masc+Pl+Nom:%^wāi    # ;
  +Adj+Masc+Pl+Gen:un       # ;
  +Adj+Masc+Pl+Dat:%^ummans # ;
  +Adj+Masc+Pl+Acc:uns      # ;

LEXICON AdjUMobFem
  +Adj+Fem+Sg+Nom:%^ī       # ;
  +Adj+Fem+Sg+Gen:jas       # ;
  +Adj+Fem+Sg+Dat:jai       # ;
  +Adj+Fem+Sg+Acc:jan       # ;
  +Adj+Fem+Pl+Nom:jas       # ;
  +Adj+Fem+Pl+Gen:jan       # ;
  +Adj+Fem+Pl+Dat:%^jāmans  # ;
  +Adj+Fem+Pl+Acc:jans      # ;

LEXICON AdjUMobNeut
  +Adj+Neut+Sg+Nom:u        # ;
  +Adj+Neut+Sg+Gen:%^was    # ;
  +Adj+Neut+Sg+Dat:usmu     # ;
  +Adj+Neut+Sg+Acc:u        # ;
  +Adj+Neut+Pl+Nom:%^wāi    # ;
  +Adj+Neut+Pl+Gen:un       # ;
  +Adj+Neut+Pl+Dat:%^ummans # ;
  +Adj+Neut+Pl+Acc:uns      # ;

! ═══ PARTIZIPIEN (agieren adjektivisch, drei Genera) ══════════════════════
!
! Twanksta-Par.68/69 sind KEINE Nomen, sondern Partizipien mit adjektivischer
! Deklination (Dat.Sg. -asmu/-jasmu, drei Genusblöcke). Zwei Typen:
!   PartPass (Par.69): passives Partizip -ts, a-stämmig, semi-mobil. Wie das
!            mobile Adjektiv, aber Dat.Sg. -asmu ist NICHT mobil (kein Gravis),
!            und Neut Nom.Pl. -āi bleibt fest. Mobile Slots: Masc Nom.Pl/Dat.Pl,
!            Fem Nom.Sg/Dat.Pl, Neut Dat.Pl. Stamm = Masc.Gen.Sg. minus -as.
!   PartAct  (Par.68): aktives Partizip -uns, eigener -us-Stamm, fest. Masc -uns,
!            Fem -usi, Neut -us; obliquer -us- + jo-artige Endungen (-jas/-jasmu/
!            -jai/-jamans). Stamm = Masc.Nom.Sg. minus -uns.

LEXICON PartPassInfl
  PartPassMasc ;
  PartPassFem ;
  PartPassNeut ;

LEXICON PartActInfl
  PartActMasc ;
  PartActFem ;
  PartActNeut ;

! ─── Passives Partizip -ts (Par.69), a-stämmig, semi-mobil ────────────────
LEXICON PartPassMasc
  +Part+Pass+Masc+Sg+Nom:s        # ;
  +Part+Pass+Masc+Pl+Nom:%^āi     # ;   ! mobil
  +Part+Pass+Masc+Sg+Gen:as       # ;
  +Part+Pass+Masc+Pl+Gen:an       # ;
  +Part+Pass+Masc+Sg+Dat:asmu     # ;   ! nicht mobil (anders als Adj-Mobil)
  +Part+Pass+Masc+Pl+Dat:%^ammans # ;   ! mobil
  +Part+Pass+Masc+Sg+Acc:an       # ;
  +Part+Pass+Masc+Pl+Acc:ans      # ;

LEXICON PartPassFem
  +Part+Pass+Fem+Sg+Nom:%^ā       # ;   ! mobil
  +Part+Pass+Fem+Pl+Nom:as        # ;
  +Part+Pass+Fem+Sg+Gen:as        # ;
  +Part+Pass+Fem+Pl+Gen:an        # ;
  +Part+Pass+Fem+Sg+Dat:ai        # ;
  +Part+Pass+Fem+Pl+Dat:%^āmans   # ;   ! mobil
  +Part+Pass+Fem+Sg+Acc:an        # ;
  +Part+Pass+Fem+Pl+Acc:ans       # ;

LEXICON PartPassNeut
  +Part+Pass+Neut+Sg+Nom:an       # ;
  +Part+Pass+Neut+Pl+Nom:āi       # ;   ! fest (anders als Masc)
  +Part+Pass+Neut+Sg+Gen:as       # ;
  +Part+Pass+Neut+Pl+Gen:an       # ;
  +Part+Pass+Neut+Sg+Dat:asmu     # ;
  +Part+Pass+Neut+Pl+Dat:%^ammans # ;   ! mobil
  +Part+Pass+Neut+Sg+Acc:an       # ;
  +Part+Pass+Neut+Pl+Acc:ans      # ;

! ─── Aktives Partizip -uns (Par.68), -us-Stamm, fest ──────────────────────
LEXICON PartActMasc
  +Part+Past+Masc+Sg+Nom:uns       # ;
  +Part+Past+Masc+Pl+Nom:usis      # ;
  +Part+Past+Masc+Sg+Gen:usjas     # ;
  +Part+Past+Masc+Pl+Gen:usin      # ;
  +Part+Past+Masc+Sg+Dat:usjasmu   # ;
  +Part+Past+Masc+Pl+Dat:usimans   # ;
  +Part+Past+Masc+Sg+Acc:usin      # ;
  +Part+Past+Masc+Pl+Acc:usins     # ;

LEXICON PartActFem
  +Part+Past+Fem+Sg+Nom:usi        # ;
  +Part+Past+Fem+Pl+Nom:usjas      # ;
  +Part+Past+Fem+Sg+Gen:usjas      # ;
  +Part+Past+Fem+Pl+Gen:usjan      # ;
  +Part+Past+Fem+Sg+Dat:usjai      # ;
  +Part+Past+Fem+Pl+Dat:usjamans   # ;
  +Part+Past+Fem+Sg+Acc:usin       # ;
  +Part+Past+Fem+Pl+Acc:usjans     # ;

LEXICON PartActNeut
  +Part+Past+Neut+Sg+Nom:us        # ;
  +Part+Past+Neut+Pl+Nom:us        # ;
  +Part+Past+Neut+Sg+Gen:usjas     # ;
  +Part+Past+Neut+Pl+Gen:usin      # ;
  +Part+Past+Neut+Sg+Dat:usjasmu   # ;
  +Part+Past+Neut+Pl+Dat:usimans   # ;
  +Part+Past+Neut+Sg+Acc:us        # ;
  +Part+Past+Neut+Pl+Acc:us        # ;

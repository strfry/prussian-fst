! Handgeschriebener generativer FST — Nomen, jo-Stämme (jo-Familie).
!
! jo-Familie = Gen.Sg. auf -jas; oblique Stamm = Gen.Sg. minus -jas (konsonantisch).
! Das `j` gehört zur ENDUNG, nicht zum Stamm (Projektentscheidung): der Stamm ist
! konsonantisch (rūs-, Andr-), die obliquen Endungen tragen das j (-jas/-ju/-jan/
! -jai/-jamans/-jans); nur der Nom.Sg. hat -is (jo-Masc) bzw. -jan (jo-Neut).
! Teilt sich gen/accent.regex; Test: gen/coverage_gen.py --family jostem.
!
!   Par  Genus  Nom.Sg Gen.Sg Dat.Sg Akk.Sg Nom.Pl  Gen.Pl Dat.Pl     Akk.Pl  mobil
!   40   masc   is     jas    ju     jan    jai     jan    jamans     jans    —
!   41   masc   is     jas    ju     jan    ^jāi    jan    ^jammans   jans    Nom.Pl, Dat.Pl
!   37   neut   jan    jas    ju     jan    ^jāi    jan    ^jammans   jans    Nom.Pl, Dat.Pl
!   38   masc   s      jas    ju     jan    jai     jan    mans       jans    —  (Stamm i-final)
!
! Par.38 (klein, 20) hat einen i-/ī-finalen Stamm (Gen.Sg. minus -jas = āudalbi-,
! idōlmadlī-); Nom.Sg. -s und Dat.Pl. -mans treten daher ohne eigenes j auf.
! Par.39 (12): Stamm = Gen.Sg. minus -ijjas (Rik-, aitagen-, warbuw-). Sieben Slots
! konkatenativ (īs/ijjas/ijju/ijjan/ijjai/ijjan/ijjans); nur der Dat.Pl. geminiert
! den Stammauslaut (Rik>imans → Rikkimans) über den Geminationsmarker > (siehe
! gen/accent.regex). Rest: einzelne Nom.Sg. mit Zusatz-Makron (aītagenīs).

Multichar_Symbols +N +Masc +Neut +Sg +Pl +Nom +Gen +Dat +Akk ^ %>

LEXICON Root
  P40Stems ;
  P41Stems ;
  P37Stems ;
  P38Stems ;
  P39Stems ;

! >>> STÄMME (Beispiel-Lexeme für `make jostem`; Deckungstest ersetzt den Block) <<<
! Lexem = Lemma+N+Genus : Stamm (Gen.Sg. minus -jas) → Paradigmen-Endungslexikon.

LEXICON P40Stems
  albinōzis+N+Masc:albinōz       P40 ;
  Andris+N+Masc:Andr             P40 ;

LEXICON P41Stems
  rūsis+N+Masc:rūs               P41 ;   ! Makron ū → u im schweren Slot
  wilnis+N+Masc:wiln             P41 ;

LEXICON P37Stems
  Ministeriwāitjan+N+Neut:Ministeriwāit P37 ;   ! Makron ā → a im schweren Slot
  wārmigarjan+N+Neut:wārmigar    P37 ;
  pannjan+N+Neut:pann            P37 ;   ! Geminate nn (fest, nicht im schweren Slot)

LEXICON P38Stems
  āudalbis+N+Masc:āudalbi        P38 ;   ! i-finaler Stamm
  idōlmadlīs+N+Masc:idōlmadlī    P38 ;   ! ī-finaler Stamm

LEXICON P39Stems
  Rikīs+N+Masc:Rik               P39 ;   ! Dat.Pl. geminiert: Rik>imans → Rikkimans
  warbuwīs+N+Masc:warbuw         P39 ;
  kraisakīs+N+Masc:kraisak       P39 ;

! >>> ENDUNGEN (ab hier vom Deckungstest gen/coverage_gen.py wiederverwendet) <<<

LEXICON P40
  +Sg+Nom:is       # ;
  +Sg+Gen:jas      # ;
  +Sg+Dat:ju       # ;
  +Sg+Akk:jan      # ;
  +Pl+Nom:jai      # ;
  +Pl+Gen:jan      # ;
  +Pl+Dat:jamans   # ;
  +Pl+Akk:jans     # ;

LEXICON P41
  +Sg+Nom:is       # ;
  +Sg+Gen:jas      # ;
  +Sg+Dat:ju       # ;
  +Sg+Akk:jan      # ;
  +Pl+Nom:%^jāi    # ;   ! Akzent auf Endung → Stamm leicht
  +Pl+Gen:jan      # ;
  +Pl+Dat:%^jammans # ;  ! Akzent auf Endung → Stamm leicht
  +Pl+Akk:jans     # ;

LEXICON P37
  +Sg+Nom:jan      # ;
  +Sg+Gen:jas      # ;
  +Sg+Dat:ju       # ;
  +Sg+Akk:jan      # ;
  +Pl+Nom:%^jāi    # ;   ! Akzent auf Endung → Stamm leicht
  +Pl+Gen:jan      # ;
  +Pl+Dat:%^jammans # ;  ! Akzent auf Endung → Stamm leicht
  +Pl+Akk:jans     # ;

LEXICON P38
  +Sg+Nom:s        # ;
  +Sg+Gen:jas      # ;
  +Sg+Dat:ju       # ;
  +Sg+Akk:jan      # ;
  +Pl+Nom:jai      # ;
  +Pl+Gen:jan      # ;
  +Pl+Dat:mans     # ;
  +Pl+Akk:jans     # ;

LEXICON P39
  +Sg+Nom:īs       # ;
  +Sg+Gen:ijjas    # ;
  +Sg+Dat:ijju     # ;
  +Sg+Akk:ijjan    # ;
  +Pl+Nom:ijjai    # ;
  +Pl+Gen:ijjan    # ;
  +Pl+Dat:%>imans  # ;   ! > geminiert den Stammauslaut: Rik>imans → Rikkimans
  +Pl+Akk:ijjans   # ;

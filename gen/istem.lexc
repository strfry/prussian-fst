! Handgeschriebener generativer FST — Nomen, i-Stämme (i-Familie).
!
! i-Familie = Gen.Sg. auf -is; der oblique Stamm ist Gen.Sg. minus -is. Neben
! gen/astem.lexc (a-Stamm) und gen/adj.lexc (Adjektive); teilt sich die
! Akzentregel gen/accent.regex. Nicht-zirkulär getestet: gen/coverage_gen.py
! speist die Stämme ALLER realen i-Stamm-Lexeme in die hier formulierten
! Endungen + die Akzentregel und misst die Deckung gegen Twanksta.
!
! ARCHITEKTUR — eine Endungstabelle PRO TWANKSTA-PARADIGMENNUMMER:
!   Der Tabellenschlüssel ist die Paradigmennummer (P52 … P60), nicht
!   (Stammklasse × Genus). Genus ist eine rein lexikalische Eigenschaft: es
!   steht als Tag am Lemma (+Masc/+Fem) und wird nur ausgegeben — es WÄHLT die
!   Tabelle nicht aus. Deshalb sind Par.52 (fem) und Par.54 (masc) zwei
!   Paradigmen mit identischer Endungstabelle, Par.56 (masc) und Par.58 (fem)
!   dagegen verschiedene Tabellen trotz gleichem Nom.Sg. -s.
!
! Die sieben Nomen-Paradigmen der i-Familie (27/29 sind pronominal, Dat.Sg.
! -ismu → keine Nomen, hier nicht enthalten):
!
!   Par  Genus  Nom.Sg Dat.Sg Nom.Pl Dat.Pl   mobil (schwerer Slot, Marker ^)
!   52   fem    i      ei     is     imans     —
!   54   masc   i      ei     is     imans     —
!   58   fem    s      ei     is     imans     —
!   56   masc   s      i      jai    imans     —
!   53   fem    ^ē     ei     is     ^īmans    Nom.Sg, Dat.Pl
!   60   fem    s      ei     is     ^immans   Dat.Pl
!   57   masc   s      i      es     ^immans   Dat.Pl
!   (Sg.Gen -is, Sg.Akk -in, Pl.Gen -in, Pl.Akk -ins durchgehend gleich.)
!
! Bewegliche Betonung (Par.53/57/60): der akzentverschobene Slot emittiert
! zwischen Stamm und Endung den Grenzmarker ^; gen/accent.regex kürzt davor ein
! Makron ODER reduziert eine Geminate im Stamm und tilgt ^. Die schwere Endung
! rechts von ^ bleibt (schwer = langes ī bzw. Geminate mm: -ē/-īmans/-immans).
!
! Bekannte, hier NICHT modellierte Reste (vom Deckungstest beziffert):
!   - Nom.Sg. -s/-is-Wechsel in Par.58/60 ist lexikalisch, nicht aus dem Stamm
!     ableitbar (gleiche Auslaute st/kt/nt geben beides) → wir generieren -s.
!   - Nom.Sg. Degemination/Kürzung vor finalem -s (lukk→luks, Instrāpill→
!     Instrāpils) ist phonotaktisch (Geminate + Konsonant), kein Akzent → aus
!     der Akzentregel bewusst herausgehalten.

Multichar_Symbols +N +Masc +Fem +Neut +Sg +Pl +Nom +Gen +Dat +Akk ^

! Diese Datei ist die HAND-GESCHRIEBENE Grammatik (Endungen + Nom.Sg.-Ausnahmen)
! und enthält bewusst KEINE Wörter. LEXICON Root verweist auf die PxxStems; deren
! Einträge (Lemma+N+Genus:Stamm  Pxx ;) werden aus twanksta generiert:
!   uv run python gen/coverage_gen.py --family istem --emit-stems build/gen-istem-stems.lexc
! Der Build hängt diesen generierten Stamm-Block an die Grammatik an (siehe Makefile).
LEXICON Root
  P52Stems ;
  P53Stems ;
  P54Stems ;
  P56Stems ;
  P57Stems ;
  P58Stems ;
  P60Stems ;
  NomSg ;         ! hand-gepflegte Nom.Sg.-Ausnahmen (siehe LEXICON NomSg unten)

! >>> ENDUNGEN — je Twanksta-Paradigmennummer eine Endungstabelle <<<

LEXICON P52
  +Sg+Nom:i       # ;
  +Sg+Gen:is      # ;
  +Sg+Dat:ei      # ;
  +Sg+Akk:in      # ;
  +Pl+Nom:is      # ;
  +Pl+Gen:in      # ;
  +Pl+Dat:imans   # ;
  +Pl+Akk:ins     # ;

LEXICON P54
  +Sg+Nom:i       # ;
  +Sg+Gen:is      # ;
  +Sg+Dat:ei      # ;
  +Sg+Akk:in      # ;
  +Pl+Nom:is      # ;
  +Pl+Gen:in      # ;
  +Pl+Dat:imans   # ;
  +Pl+Akk:ins     # ;

LEXICON P58
  +Sg+Nom:s       # ;
  +Sg+Gen:is      # ;
  +Sg+Dat:ei      # ;
  +Sg+Akk:in      # ;
  +Pl+Nom:is      # ;
  +Pl+Gen:in      # ;
  +Pl+Dat:imans   # ;
  +Pl+Akk:ins     # ;

LEXICON P56
  +Sg+Nom:s       # ;
  +Sg+Gen:is      # ;
  +Sg+Dat:i       # ;
  +Sg+Akk:in      # ;
  +Pl+Nom:jai     # ;
  +Pl+Gen:in      # ;
  +Pl+Dat:imans   # ;
  +Pl+Akk:ins     # ;

LEXICON P53
  +Sg+Nom:%^ē      # ;   ! Akzent auf Endung → Stamm leicht
  +Sg+Gen:is       # ;
  +Sg+Dat:ei       # ;
  +Sg+Akk:in       # ;
  +Pl+Nom:is       # ;
  +Pl+Gen:in       # ;
  +Pl+Dat:%^īmans  # ;   ! Akzent auf Endung → Stamm leicht
  +Pl+Akk:ins      # ;

LEXICON P60
  +Sg+Nom:s        # ;
  +Sg+Gen:is       # ;
  +Sg+Dat:ei       # ;
  +Sg+Akk:in       # ;
  +Pl+Nom:is       # ;
  +Pl+Gen:in       # ;
  +Pl+Dat:%^immans # ;   ! Akzent auf Endung → Stamm leicht
  +Pl+Akk:ins      # ;

LEXICON P57
  +Sg+Nom:s        # ;
  +Sg+Gen:is       # ;
  +Sg+Dat:i        # ;
  +Sg+Akk:in       # ;
  +Pl+Nom:es       # ;
  +Pl+Gen:in       # ;
  +Pl+Dat:%^immans # ;   ! Akzent auf Endung → Stamm leicht
  +Pl+Akk:ins      # ;

! ===========================================================================
! Nom.Sg.-AUSNAHMEN — hand-gepflegt
! ===========================================================================
! Manche i-Stämme behalten den Themavokal im Nom.Sg. (Arkt+is statt Arkt+s);
! ob -s oder -is steht, ist lexikalisch (gleiche Auslaute st/kt/nt geben beides)
! und NICHT aus dem obliquen Stamm ableitbar. Statt einer externen Liste steht
! die Ausnahme hier im lexc: die fertige Nom.Sg.-Oberfläche in LEXICON NomSg,
! die restlichen 7 Formen kommen regulär (der Stamm wird in PxxStems auf die
! -_o-Klasse geleitet, die kein Nom.Sg. emittiert → kein doppelter/falscher Nom).
!
! Editieren: eine Zeile pro Ausnahme, "Lemma+N+Genus+Sg+Nom:<Oberfläche>  # ;"
! (kein Stamm nötig — nur das fertige Wort) und den Stamm in PxxStems auf die
! zugehörige -_o-Klasse zeigen lassen. Deckt jede Nom.Sg.-Irregularität ab
! (auch Länge pintīs, Geminate aupallē), nicht nur den -is/-s-Wechsel.

LEXICON NomSg
  ! Par.56 (masc)
  Narwis+N+Masc+Sg+Nom:Narwis                 # ;
  wāsis+N+Masc+Sg+Nom:wāsis                   # ;
  trustis+N+Masc+Sg+Nom:trustis               # ;
  ! Par.57 (masc)
  sasnis+N+Masc+Sg+Nom:sasnis                 # ;
  skārstis+N+Masc+Sg+Nom:skārstis             # ;
  ! Par.58 (fem)
  Antarktis+N+Fem+Sg+Nom:Antarktis            # ;
  Arktis+N+Fem+Sg+Nom:Arktis                  # ;
  glāstis+N+Fem+Sg+Nom:glāstis                # ;
  dimstis+N+Fem+Sg+Nom:dimstis                # ;
  nietnīstis+N+Fem+Sg+Nom:nietnīstis          # ;
  etnīstis+N+Fem+Sg+Nom:etnīstis              # ;
  kāmstis+N+Fem+Sg+Nom:kāmstis                # ;
  klupstis+N+Fem+Sg+Nom:klupstis              # ;
  krūmpstis+N+Fem+Sg+Nom:krūmpstis            # ;
  kuntis+N+Fem+Sg+Nom:kuntis                  # ;
  kāisnis+N+Fem+Sg+Nom:kāisnis                # ;
  spellaukstis+N+Fem+Sg+Nom:spellaukstis      # ;
  lūsis+N+Fem+Sg+Nom:lūsis                    # ;
  waīstis+N+Fem+Sg+Nom:waīstis                # ;
  pawīstis+N+Fem+Sg+Nom:pawīstis              # ;
  pintīs+N+Fem+Sg+Nom:pintīs                  # ;   ! Länge -īs, nicht -is
  pussis+N+Fem+Sg+Nom:pussis                  # ;
  sirwis+N+Fem+Sg+Nom:sirwis                  # ;
  wundaswarstis+N+Fem+Sg+Nom:wundaswarstis    # ;
  ! Par.60 (fem)
  anglis+N+Fem+Sg+Nom:anglis                  # ;
  astis+N+Fem+Sg+Nom:astis                    # ;
  grānstis+N+Fem+Sg+Nom:grānstis              # ;
  saknis+N+Fem+Sg+Nom:saknis                  # ;
  sakstis+N+Fem+Sg+Nom:sakstis                # ;
  snākstis+N+Fem+Sg+Nom:snākstis              # ;
  tankis+N+Fem+Sg+Nom:tankis                  # ;
  ugnis+N+Fem+Sg+Nom:ugnis                    # ;
  ! Par.53 (fem) — Geminate bleibt (aupallē, nicht aupalē)
  aupallē+N+Fem+Sg+Nom:aupallē                # ;

! -_o-Klassen: identisch zur Basisklasse, aber OHNE +Sg+Nom (den liefert NomSg).
LEXICON P56_o
  +Sg+Gen:is      # ;
  +Sg+Dat:i       # ;
  +Sg+Akk:in      # ;
  +Pl+Nom:jai     # ;
  +Pl+Gen:in      # ;
  +Pl+Dat:imans   # ;
  +Pl+Akk:ins     # ;

LEXICON P57_o
  +Sg+Gen:is       # ;
  +Sg+Dat:i        # ;
  +Sg+Akk:in       # ;
  +Pl+Nom:es       # ;
  +Pl+Gen:in       # ;
  +Pl+Dat:%^immans # ;
  +Pl+Akk:ins      # ;

LEXICON P58_o
  +Sg+Gen:is      # ;
  +Sg+Dat:ei      # ;
  +Sg+Akk:in      # ;
  +Pl+Nom:is      # ;
  +Pl+Gen:in      # ;
  +Pl+Dat:imans   # ;
  +Pl+Akk:ins     # ;

LEXICON P60_o
  +Sg+Gen:is       # ;
  +Sg+Dat:ei       # ;
  +Sg+Akk:in       # ;
  +Pl+Nom:is       # ;
  +Pl+Gen:in       # ;
  +Pl+Dat:%^immans # ;
  +Pl+Akk:ins      # ;

LEXICON P53_o
  +Sg+Gen:is       # ;
  +Sg+Dat:ei       # ;
  +Sg+Akk:in       # ;
  +Pl+Nom:is       # ;
  +Pl+Gen:in       # ;
  +Pl+Dat:%^īmans  # ;
  +Pl+Akk:ins      # ;

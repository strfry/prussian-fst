! Generative FST for finite verbs (synthetic forms only). Data-free ending grammar.
! Atoms are defined once; each stem entry continues into one atom. Tag order:
! +V +Modus [+Tempus] +Person/Num (fusioniert: +Sg1 +Sg2 +SP3 +Pl1 +Pl2).
! +Refl optional (surface drops " si").

Multichar_Symbols +V +Ind +Subj +Opt +Prs +Prt +Imprt +Sg1 +Sg2 +SP3 +Pl1 +Pl2 +Refl

LEXICON Root
  P85PresStems ;
  P85NonfinStems ;
  P132PresStems ;
  P132NonfinStems ;
  P138PresStems ;
  P138NonfinStems ;
  P134PresStems ;
  P134NonfinStems ;
  P139PresStems ;
  P139NonfinStems ;
  P143PresStems ;
  P143NonfinStems ;
  P144NonfinStems ;
  P144PresStems ;
  P144PretStems ;
  P142PresStems ;
  P142NonfinStems ;
  P136PresStems ;
  P136PretStems ;
  P136NonfinStems ;
  P111NonfinStems ;
  P111PresStems ;
  P111PretStems ;
  P71PresStems ;
  P71NonfinStems ;
  P75PresStems ;
  P75NonfinStems ;
  VerbStrongStems ;

! ── Present indicative ──
LEXICON Pres_A          ! a/a/a/imai/itei
  +V+Ind+Prs+Sg1:a    VerbEnd ;
  +V+Ind+Prs+Sg2:a    VerbEnd ;
  +V+Ind+Prs+SP3:a       VerbEnd ;
  +V+Ind+Prs+Pl1:imai VerbEnd ;
  +V+Ind+Prs+Pl2:itei VerbEnd ;

LEXICON Pres_I          ! i/i/i/imai/itei
  +V+Ind+Prs+Sg1:i    VerbEnd ;
  +V+Ind+Prs+Sg2:i    VerbEnd ;
  +V+Ind+Prs+SP3:i       VerbEnd ;
  +V+Ind+Prs+Pl1:imai VerbEnd ;
  +V+Ind+Prs+Pl2:itei VerbEnd ;

LEXICON Pres_Aa         ! a/a/a/amai/atei
  +V+Ind+Prs+Sg1:a    VerbEnd ;
  +V+Ind+Prs+Sg2:a    VerbEnd ;
  +V+Ind+Prs+SP3:a       VerbEnd ;
  +V+Ind+Prs+Pl1:amai VerbEnd ;
  +V+Ind+Prs+Pl2:atei VerbEnd ;

LEXICON Pres_Ja         ! ja/ja/ja/imai/itei
  +V+Ind+Prs+Sg1:ja   VerbEnd ;
  +V+Ind+Prs+Sg2:ja   VerbEnd ;
  +V+Ind+Prs+SP3:ja      VerbEnd ;
  +V+Ind+Prs+Pl1:imai VerbEnd ;
  +V+Ind+Prs+Pl2:itei VerbEnd ;

LEXICON Pres_Jja        ! ja/ja/ja/jamai/jatei
  +V+Ind+Prs+Sg1:ja    VerbEnd ;
  +V+Ind+Prs+Sg2:ja    VerbEnd ;
  +V+Ind+Prs+SP3:ja       VerbEnd ;
  +V+Ind+Prs+Pl1:jamai VerbEnd ;
  +V+Ind+Prs+Pl2:jatei VerbEnd ;

LEXICON Pres_Ui         ! ui/ui/ui/wimai/witei
  +V+Ind+Prs+Sg1:ui    VerbEnd ;
  +V+Ind+Prs+Sg2:ui    VerbEnd ;
  +V+Ind+Prs+SP3:ui       VerbEnd ;
  +V+Ind+Prs+Pl1:wimai VerbEnd ;
  +V+Ind+Prs+Pl2:witei VerbEnd ;

! ── Preterite indicative ──
LEXICON Pret_A          ! a/a/a/amai/atei
  +V+Ind+Prt+Sg1:a    VerbEnd ;
  +V+Ind+Prt+Sg2:a    VerbEnd ;
  +V+Ind+Prt+SP3:a       VerbEnd ;
  +V+Ind+Prt+Pl1:amai VerbEnd ;
  +V+Ind+Prt+Pl2:atei VerbEnd ;

LEXICON Pret_Ai         ! a/a/a/imai/itei
  +V+Ind+Prt+Sg1:a    VerbEnd ;
  +V+Ind+Prt+Sg2:a    VerbEnd ;
  +V+Ind+Prt+SP3:a       VerbEnd ;
  +V+Ind+Prt+Pl1:imai VerbEnd ;
  +V+Ind+Prt+Pl2:itei VerbEnd ;

LEXICON Pret_I          ! i/i/i/imai/itei
  +V+Ind+Prt+Sg1:i    VerbEnd ;
  +V+Ind+Prt+Sg2:i    VerbEnd ;
  +V+Ind+Prt+SP3:i       VerbEnd ;
  +V+Ind+Prt+Pl1:imai VerbEnd ;
  +V+Ind+Prt+Pl2:itei VerbEnd ;

LEXICON Pret_0          ! 0/0/0/mai/tei
  +V+Ind+Prt+Sg1:0    VerbEnd ;
  +V+Ind+Prt+Sg2:0    VerbEnd ;
  +V+Ind+Prt+SP3:0       VerbEnd ;
  +V+Ind+Prt+Pl1:mai  VerbEnd ;
  +V+Ind+Prt+Pl2:tei  VerbEnd ;

! ── Subjunctive + optative ──
LEXICON SubjOpt         ! sei + lai/lai/lai/limai/litei
  +V+Opt+SP3:sei          VerbEnd ;
  +V+Subj+Sg1:lai      VerbEnd ;
  +V+Subj+Sg2:lai      VerbEnd ;
  +V+Subj+SP3:lai         VerbEnd ;
  +V+Subj+Pl1:limai    VerbEnd ;
  +V+Subj+Pl2:litei    VerbEnd ;

! ── Imperative ──
LEXICON Imp_Ais         ! ais/aiti
  +V+Imprt+Sg2:ais       VerbEnd ;
  +V+Imprt+Pl2:aiti      VerbEnd ;

LEXICON Imp_Is          ! is/iti
  +V+Imprt+Sg2:is        VerbEnd ;
  +V+Imprt+Pl2:iti       VerbEnd ;

LEXICON Imp_S           ! s/ti
  +V+Imprt+Sg2:s         VerbEnd ;
  +V+Imprt+Pl2:ti        VerbEnd ;

LEXICON Imp_Siti        ! s/iti
  +V+Imprt+Sg2:s         VerbEnd ;
  +V+Imprt+Pl2:iti       VerbEnd ;

LEXICON Imp_Jais        ! jais/jaiti
  +V+Imprt+Sg2:jais      VerbEnd ;
  +V+Imprt+Pl2:jaiti     VerbEnd ;

! ── Optional reflexive suffix (surface drops " si") ──
LEXICON VerbEnd
  0:0 # ;
  +Refl:0 # ;

! Generative FST for finite verbs (synthetic forms only). Data-free ending grammar,
! tested non-circularly against twanksta (gen/coverage_verb.py). Stems are emitted
! from twanksta (--emit-stems) into the P*Stems / VerbStrongStems lexicons below;
! each stem entry continues into one atom. Atoms are defined once. Tag order:
! +V +Mood [+Tense] +Pers [+Num] (P3 has no number). +Refl optional (surface drops " si").

Multichar_Symbols +V +Ind +Pres +Pret +Subj +Opt +Imp +P1 +P2 +P3 +Sg +Pl +Refl

LEXICON Root
  P85PresStems ;
  P85NonfinStems ;
  P132PresStems ;
  P132NonfinStems ;
  P138PresStems ;
  P138NonfinStems ;
  P134PresStems ;
  P134NonfinStems ;
  P139PresStems ;
  P139NonfinStems ;
  P143PresStems ;
  P143NonfinStems ;
  P144NonfinStems ;
  P144PresStems ;
  P144PretStems ;
  P142PresStems ;
  P142NonfinStems ;
  P136PresStems ;
  P136PretStems ;
  P136NonfinStems ;
  P111NonfinStems ;
  P111PresStems ;
  P111PretStems ;
  P71PresStems ;
  P71NonfinStems ;
  P75PresStems ;
  P75NonfinStems ;
  VerbStrongStems ;

! ── Present indicative ──
LEXICON Pres_A          ! a/a/a/imai/itei
  +Ind+Pres+P1+Sg:a    VerbEnd ;
  +Ind+Pres+P2+Sg:a    VerbEnd ;
  +Ind+Pres+P3:a       VerbEnd ;
  +Ind+Pres+P1+Pl:imai VerbEnd ;
  +Ind+Pres+P2+Pl:itei VerbEnd ;

LEXICON Pres_I          ! i/i/i/imai/itei
  +Ind+Pres+P1+Sg:i    VerbEnd ;
  +Ind+Pres+P2+Sg:i    VerbEnd ;
  +Ind+Pres+P3:i       VerbEnd ;
  +Ind+Pres+P1+Pl:imai VerbEnd ;
  +Ind+Pres+P2+Pl:itei VerbEnd ;

LEXICON Pres_Aa         ! a/a/a/amai/atei
  +Ind+Pres+P1+Sg:a    VerbEnd ;
  +Ind+Pres+P2+Sg:a    VerbEnd ;
  +Ind+Pres+P3:a       VerbEnd ;
  +Ind+Pres+P1+Pl:amai VerbEnd ;
  +Ind+Pres+P2+Pl:atei VerbEnd ;

LEXICON Pres_Ja         ! ja/ja/ja/imai/itei
  +Ind+Pres+P1+Sg:ja   VerbEnd ;
  +Ind+Pres+P2+Sg:ja   VerbEnd ;
  +Ind+Pres+P3:ja      VerbEnd ;
  +Ind+Pres+P1+Pl:imai VerbEnd ;
  +Ind+Pres+P2+Pl:itei VerbEnd ;

LEXICON Pres_Jja        ! ja/ja/ja/jamai/jatei
  +Ind+Pres+P1+Sg:ja    VerbEnd ;
  +Ind+Pres+P2+Sg:ja    VerbEnd ;
  +Ind+Pres+P3:ja       VerbEnd ;
  +Ind+Pres+P1+Pl:jamai VerbEnd ;
  +Ind+Pres+P2+Pl:jatei VerbEnd ;

LEXICON Pres_Ui         ! ui/ui/ui/wimai/witei
  +Ind+Pres+P1+Sg:ui    VerbEnd ;
  +Ind+Pres+P2+Sg:ui    VerbEnd ;
  +Ind+Pres+P3:ui       VerbEnd ;
  +Ind+Pres+P1+Pl:wimai VerbEnd ;
  +Ind+Pres+P2+Pl:witei VerbEnd ;

! ── Preterite indicative ──
LEXICON Pret_A          ! a/a/a/amai/atei
  +Ind+Pret+P1+Sg:a    VerbEnd ;
  +Ind+Pret+P2+Sg:a    VerbEnd ;
  +Ind+Pret+P3:a       VerbEnd ;
  +Ind+Pret+P1+Pl:amai VerbEnd ;
  +Ind+Pret+P2+Pl:atei VerbEnd ;

LEXICON Pret_Ai         ! a/a/a/imai/itei
  +Ind+Pret+P1+Sg:a    VerbEnd ;
  +Ind+Pret+P2+Sg:a    VerbEnd ;
  +Ind+Pret+P3:a       VerbEnd ;
  +Ind+Pret+P1+Pl:imai VerbEnd ;
  +Ind+Pret+P2+Pl:itei VerbEnd ;

LEXICON Pret_I          ! i/i/i/imai/itei
  +Ind+Pret+P1+Sg:i    VerbEnd ;
  +Ind+Pret+P2+Sg:i    VerbEnd ;
  +Ind+Pret+P3:i       VerbEnd ;
  +Ind+Pret+P1+Pl:imai VerbEnd ;
  +Ind+Pret+P2+Pl:itei VerbEnd ;

LEXICON Pret_0          ! 0/0/0/mai/tei
  +Ind+Pret+P1+Sg:0    VerbEnd ;
  +Ind+Pret+P2+Sg:0    VerbEnd ;
  +Ind+Pret+P3:0       VerbEnd ;
  +Ind+Pret+P1+Pl:mai  VerbEnd ;
  +Ind+Pret+P2+Pl:tei  VerbEnd ;

! ── Subjunctive + optative ──
LEXICON SubjOpt         ! sei + lai/lai/lai/limai/litei
  +Opt+P3:sei          VerbEnd ;
  +Subj+P1+Sg:lai      VerbEnd ;
  +Subj+P2+Sg:lai      VerbEnd ;
  +Subj+P3:lai         VerbEnd ;
  +Subj+P1+Pl:limai    VerbEnd ;
  +Subj+P2+Pl:litei    VerbEnd ;

! ── Imperative ──
LEXICON Imp_Ais         ! ais/aiti
  +Imp+P2+Sg:ais       VerbEnd ;
  +Imp+P2+Pl:aiti      VerbEnd ;

LEXICON Imp_Is          ! is/iti
  +Imp+P2+Sg:is        VerbEnd ;
  +Imp+P2+Pl:iti       VerbEnd ;

LEXICON Imp_S           ! s/ti
  +Imp+P2+Sg:s         VerbEnd ;
  +Imp+P2+Pl:ti        VerbEnd ;

LEXICON Imp_Siti        ! s/iti
  +Imp+P2+Sg:s         VerbEnd ;
  +Imp+P2+Pl:iti       VerbEnd ;

LEXICON Imp_Jais        ! jais/jaiti
  +Imp+P2+Sg:jais      VerbEnd ;
  +Imp+P2+Pl:jaiti     VerbEnd ;

! ── Optional reflexive suffix (surface drops " si") ──
LEXICON VerbEnd
  0:0 # ;
  +Refl:0 # ;

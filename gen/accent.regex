! Bewegliche-Betonung-Regel für die handgeschriebenen generativen Stammklassen
! (gen/astem.lexc, gen/adj.lexc, gen/istem.lexc).
!
! Die akzentverschobenen Slots emittieren zwischen Stamm und Endung den abstrakten
! Akzentgrenze-Marker ^. Wandert die Betonung auf die Endung, verliert der Stamm
! sein schweres Merkmal:
!   - ein Makron wird kurz          (ōrigan^āi   → origanāi,  bīl^ē → bilē)
!   - eine Geminate vereinfacht sich (Mettel^āi   → Metelāi,   nagg^ē → nagē)
! Danach wird ^ getilgt. Auslöser ist ein morphologischer Marker (^), keine
! erfundene Geminate — die Regel greift nur, wo ^ steht (mobile Lexeme in ihren
! verschobenen Slots), und kann nicht auf Voll-/Festakzentformen lecken.
!
! REDUKTIONS-UMFANG: alle schweren Merkmale des Stamms vor ^ werden reduziert
! (volle Destressung). Das ist die datenbasiert bessere Wahl — bei mehrsilbigen
! Komposita reduzieren die mobilen Slots regelmäßig ALLE Makrone
! (stāminadeīkt^āi → staminadeiktāi). Einige (proper nouns wie Instrā·pil,
! Zahlwort astōnadesīmt) behalten die prätonische Länge; das ist die Minderheit
! und wird als Rest/Dateninkonsistenz behandelt, nicht per Sonderregel.
!
! Makron- und Geminatenreduktion müssen getrennte Regeln bleiben: xfst erlaubt in
! EINER parallelen Ersetzung keine gemischte Ein-/Zwei-Symbol-Ersetzung, und
! eckige Klammern um die Pfeil-Liste scheitern ("Could not define variable").

define NotBound [? - %^];   ! jedes Symbol außer dem Grenzmarker ^

! Makronkürzung im Stamm vor der Akzentgrenze.
define Shorten  ā -> a , ē -> e , ī -> i , ō -> o , ū -> u
                || _ NotBound* %^ ;

! Degemination im Stamm vor der Akzentgrenze (gleicher Doppelkonsonant → einfach).
define Degem    b b -> b , c c -> c , d d -> d , f f -> f , g g -> g ,
                h h -> h , j j -> j , k k -> k , l l -> l , m m -> m ,
                n n -> n , p p -> p , r r -> r , s s -> s , t t -> t ,
                v v -> v , w w -> w , z z -> z
                || _ NotBound* %^ ;

define DropBound %^ -> 0 ;

! Einsilbenregel / Koda-Vereinfachung: eine Stamm-Geminate vereinfacht sich vor
! wortfinalem -s (Nom.Sg.). Im Einsilber ist der Akzent eindeutig, die
! Geminatenschreibung also entbehrlich: lukk+s → luks, pill+s → pils, ass+s → ass.
! Gilt auch mehrsilbig vor -s (Instrāpill+s → Instrāpils); Makrone bleiben (nur die
! Geminate fällt). Unabhängig vom Akzentmarker ^ → auf die fertige Oberfläche
! (nach DropBound). Greift nur bei direkt an den Stamm tretendem -s (Nom.Sg.); alle
! anderen Endungen haben einen Vokal vor ihrem s.
define CodaDegem b b -> b , c c -> c , d d -> d , f f -> f , g g -> g ,
                 h h -> h , j j -> j , k k -> k , l l -> l , m m -> m ,
                 n n -> n , p p -> p , r r -> r , s s -> s , t t -> t ,
                 v v -> v , w w -> w , z z -> z
                 || _ s .#. ;

! Geminations-Marker > (Spiegel von ^): verdoppelt den unmittelbar davor stehenden
! Konsonanten, dann wird > getilgt. Nur für die wenigen Paradigmen, deren Dat.Pl.
! den Stammauslaut geminiert (Twanksta-Par.39: Rik>imans → Rikkimans,
! aitagen>imans → aitagennimans). Greift nur, wo > gesetzt ist.
define Geminate  b -> b b , c -> c c , d -> d d , f -> f f , g -> g g ,
                 h -> h h , j -> j j , k -> k k , l -> l l , m -> m m ,
                 n -> n n , p -> p p , r -> r r , s -> s s , t -> t t ,
                 v -> v v , w -> w w , z -> z z
                 || _ %> ;
define DropGem   %> -> 0 ;

regex Shorten .o. Degem .o. DropBound .o. CodaDegem .o. Geminate .o. DropGem ;
save stack build/gen-accent.hfst
quit

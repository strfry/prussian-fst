! Handgeschriebener generativer FST — Nomen, u-Stämme (u-Familie).
!
! u-Familie = Gen.Sg. auf -us; oblique Stamm = Gen.Sg. minus -us. Parallel zu
! gen/istem.lexc und gen/astem.lexc; teilt sich gen/accent.regex.
!
! ARCHITEKTUR wie sonst — eine Endungstabelle PRO TWANKSTA-PARADIGMENNUMMER,
! Genus als Lemma-Tag:
!
!   Par  Genus  Nom.Sg Gen.Sg Dat.Sg Akk.Sg Nom.Pl Gen.Pl Dat.Pl    Akk.Pl  mobil
!   42   masc   us     us     u      un     us     un     umans     uns     —
!   43   masc   s      us     u      un     us     un     ^ummans   uns     Dat.Pl
!   44   neut   u      us     u      u      u      us     u         u       —
!
! Par.42 (fest) und Par.43 unterscheiden sich im Nom.Sg. (-us vs -s) und in der
! beweglichen Betonung (Par.43 Dat.Pl. schwer -ummans, Stamm leicht:
! dāng+^ummans → dangummans). Par.44 (Neutrum) ist bis auf Gen.Sg./Gen.Pl. -us
! durchweg -u.

Multichar_Symbols +N +Msc +Neu +Sg +Pl +Nom +Gen +Dat +Acc ^

LEXICON Root
  P42Stems ;
  P43Stems ;
  P44Stems ;

! Hand-geschriebene Grammatik (nur Endungen, KEINE Wörter). LEXICON Root oben
! verweist auf die PxxStems; deren Einträge (Lemma+N+Genus:Stamm  Pxx ;) kommen
! aus twanksta, der Build hängt sie an (siehe Makefile):

! >>> ENDUNGEN — je Twanksta-Paradigmennummer eine Endungstabelle <<<

LEXICON P42
  +N+Sg+Nom:us       # ;
  +N+Sg+Gen:us       # ;
  +N+Sg+Dat:u        # ;
  +N+Sg+Acc:un       # ;
  +N+Pl+Nom:us       # ;
  +N+Pl+Gen:un       # ;
  +N+Pl+Dat:umans    # ;
  +N+Pl+Acc:uns      # ;

LEXICON P43
  +N+Sg+Nom:s        # ;
  +N+Sg+Gen:us       # ;
  +N+Sg+Dat:u        # ;
  +N+Sg+Acc:un       # ;
  +N+Pl+Nom:us       # ;
  +N+Pl+Gen:un       # ;
  +N+Pl+Dat:%^ummans # ;   ! Akzent auf Endung → Stamm leicht
  +N+Pl+Acc:uns      # ;

LEXICON P44
  +N+Sg+Nom:u        # ;
  +N+Sg+Gen:us       # ;
  +N+Sg+Dat:u        # ;
  +N+Sg+Acc:u        # ;
  +N+Pl+Nom:u        # ;
  +N+Pl+Gen:us       # ;
  +N+Pl+Dat:u        # ;
  +N+Pl+Acc:u        # ;

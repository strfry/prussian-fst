! Proper nouns — Orts-/Personennamen, korpusbelegt.
! Dispatched before regular nouns (via root.lexc: ProperNouns before Nouns).

LEXICON ProperNouns

  ! Nidda — Fluss/Stadt (fem. ā-Stamm: -a/-as/-ai/-an)
  Nidda+N+Prop+Sg+Nom+Fem:Nidda   # ;
  Nidda+N+Prop+Sg+Gen+Fem:Niddas  # ;
  Nidda+N+Prop+Sg+Dat+Fem:Niddai  # ;
  Nidda+N+Prop+Sg+Acc+Fem:Niddan  # ;

  ! Kānts — Immanuel Kant (masc. o-Stamm: -s/-as/-u/-an)
  Kānts+N+Prop+Sg+Nom+Msc:Kānts   # ;
  Kānts+N+Prop+Sg+Gen+Msc:Kāntas  # ;
  Kānts+N+Prop+Sg+Dat+Msc:Kāntu   # ;
  Kānts+N+Prop+Sg+Acc+Msc:Kāntan  # ;

  ! Luīzi — Personenname (fem. ē-Stamm: -i/-is/-ei/-in)
  Luīzi+N+Prop+Sg+Nom+Fem:Luīzi  # ;
  Luīzi+N+Prop+Sg+Gen+Fem:Luīzis # ;
  Luīzi+N+Prop+Sg+Dat+Fem:Luīzei # ;
  Luīzi+N+Prop+Sg+Acc+Fem:Luīzin # ;

  ! Tilzē — Stadt Tilsit (fem. ē-Stamm: -ē/-es/-ei/-in)
  Tilzē+N+Prop+Sg+Nom+Fem:Tilzē  # ;
  Tilzē+N+Prop+Sg+Gen+Fem:Tilzes # ;
  Tilzē+N+Prop+Sg+Dat+Fem:tilzei  # ;
  Tilzē+N+Prop+Sg+Acc+Fem:tilzin  # ;

  ! Ālberts — Personenname (masc. o-Stamm)
  Ālberts+N+Prop+Sg+Nom+Msc:Ālberts  # ;

  ! Trīmps — Name (masc. o-Stamm)
  Trīmps+N+Prop+Sg+Nom+Msc:Trīmps   # ;
  Trīmps+N+Prop+Sg+Gen+Msc:Trīmpas  # ;
  Trīmps+N+Prop+Sg+Dat+Msc:Trīmpu   # ;
  Trīmps+N+Prop+Sg+Acc+Msc:trīmpan  # ;

  ! Kulakōws — russ./lit. Familienname (masc. o-Stamm)
  Kulakōws+N+Prop+Sg+Nom+Msc:Kulakōws # ;

  ! waraprūsai — „Altpreußen" (Pluraletantum, PlNom)
  waraprūsai+N+Prop+Pl+Nom+Msc:waraprūsai # ;

  tenā+Pron+P3+Fem+Pl+Gen:tenēisan  # ;
  tenā+Pron+P3+Fem+Pl+Dat:tenēimans  # ;
  tenā+Pron+P3+Fem+Pl+Acc:tennans  # ;

! ─── Enclitic pronouns — 3rd person (+P3+Encl) ─────────────────── ─

  ! di — 3sg/pl encl neut (es) — Neut-Form ist invariabel "di"

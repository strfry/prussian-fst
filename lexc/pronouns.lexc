! pronouns — hand-curated (nicht auto-generiert von gen_lexc.py)
! Person/Enclitic-Tags aus Twanksta desc (pn 1/2/3, encl).
! Source: data/external/twanksta_entries.json (paradigm 1-20)
! Suppletive Paradigmen aufgespalten: as=Sg, mes=Pl, etc.

LEXICON Pronouns

! ─── Personal pronouns — 1st person (+P1) ──────────────────────── ─

  ! as — 1sg (ich)
  as+Pron+P1+Sg+Nom:as  # ;
  as+Pron+P1+Sg+Gen:māise  # ;
  as+Pron+P1+Sg+Dat:mennei  # ;
  as+Pron+P1+Sg+Acc:men  # ;

  ! mes — 1pl (wir)
  mes+Pron+P1+Pl+Nom:mes  # ;
  mes+Pron+P1+Pl+Gen:nūse  # ;
  mes+Pron+P1+Pl+Dat:nūmans  # ;
  mes+Pron+P1+Pl+Acc:mans  # ;

! ─── Personal pronouns — 2nd person (+P2) ──────────────────────── ─

  ! tū — 2sg (du)
  tū+Pron+P2+Sg+Nom:tū  # ;
  tū+Pron+P2+Sg+Gen:twāise  # ;
  tū+Pron+P2+Sg+Dat:tebbei  # ;
  tū+Pron+P2+Sg+Acc:ten  # ;

  ! jūs — 2pl (ihr)
  jūs+Pron+P2+Pl+Nom:jūs  # ;
  jūs+Pron+P2+Pl+Gen:jūse  # ;
  jūs+Pron+P2+Pl+Dat:jūmans  # ;
  jūs+Pron+P2+Pl+Acc:wans  # ;

! ─── Personal pronouns — 3rd person (+P3, suppletive) ──────────── ─

  ! tāns — 3sg masc (er)
  tāns+Pron+P3+Msc+Sg+Nom:tāns  # ;
  tāns+Pron+P3+Msc+Sg+Gen:tenesse  # ;
  tāns+Pron+P3+Msc+Sg+Dat:tenesmu  # ;
  tāns+Pron+P3+Msc+Sg+Acc:tennan  # ;

  ! tenā — 3sg fem (sie)

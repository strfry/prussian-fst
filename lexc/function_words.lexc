! Function words — hand-written override.
! Dispatched before Nouns so they take precedence.
!
! WS3: Invariable mit NVH-Eintrag (pos adv/prep/postp/intj/part/cconj/sconj/num,
! indeklinable Nomen) werden aus der lean NVH gebacken (LEXICON Invariables); ihre
! Wortart pflegt corpus/ids/invariable_pos.tsv. Hier steht NUR, was die NVH nicht
! als Invariable führt: Lemmata ohne Twanksta-Eintrag bzw. ohne pos, und Einzelformen
! flektierender Lexeme, die deren Paradigma nicht abdeckt.
! ACHTUNG: Zeilen mit "UNSICHER" sind nicht abgesicherte Klassifikationen —
! vor UD-Annotation gegenprüfen.

LEXICON FunctionWords
  ! Partikeln
  ne+Pcle:ne            # ;
  te+Pcle:te            # ;
  uka+Pcle:uka          # ;
  madli+Pcle:madli      # ; ! UNSICHER: „bitte" — Pcle oder erstarrte Verbform (3.Sg zu madlītun)?

  ! Konjunktionen
  ei+CC:ei            # ;
  stā+CC:stā          # ;
  ! ka: moderne Sprech-Variante von kāi „dass/ob" (Gebrauchskorpus YT; Enchiridion
  ! nur kāi). Homonym zu kas+Pron+Neu; per CG nach Verba dicendi gewählt.
  ka+CS:ka           # ; ! „dass, ob"
  kaīgi+CC:kaīgi      # ; ! UNSICHER: „wie" — Vokalvarianten-Form von kāigi

  ! Adverbien
  nikaddan+Adv:nikaddan  # ; ! „niemals"
  nitāli+Adv:nitāli      # ; ! UNSICHER: „nicht so sehr/(so) sehr"?
  nimazīngi+Adv:nimazīngi # ; ! UNSICHER: „ziemlich"?
  delli+Adv:delli      # ; ! UNSICHER: „einige, etliche" — Adv oder indekl. Pron?

  ! Pronomen-Formen, die die Paradigmen nicht abdecken
  stā+Pron+Sg+Nom+Fem:stā  # ;
  ! Reflexivpronomina (Twanksta sin/sebbei ohne Formen-Tabelle; zu „Swāise acc/dat")
  sin+Pron+Refl+Acc:sin     # ; ! reflexiv, Akkusativ („sich")
  sebbei+Pron+Refl+Dat:sebbei # ; ! reflexiv, Dativ („sich")
  ! Enklitika (K5): Twanksta mi/ti „encl /As/ bzw. /Tū/ dat, acc", ohne pos.
  as+Pron+P1+Encl+Sg+Dat:mi  # ;
  as+Pron+P1+Encl+Sg+Acc:mi  # ;
  tū+Pron+P2+Encl+Sg+Dat:ti  # ;
  tū+Pron+P2+Encl+Sg+Acc:ti  # ;

  ! Modus relativus (§18): NUR die im Gebrauchskorpus verwendete Einzelform (2×,
  ! „tāns astits per gārban"); Twanksta: „↑Būtwei mod rel [astits 61 MK]".
  ! KEINE produktive -ts-Reihe!
  būtwei+V+Rel+Prs+SP3:astits # ; ! „sei angeblich"
  ! perwaidinnas = kontrahiertes „perwaidinna si" (Twanksta-Verweis
  ! „[Perwaidīntun si drv]"; Gebrauchskorpus YT 1×). Spiegelt alle Zellen, in
  ! denen die Vollform „perwaidinna si" lautet. P3 numeruslos (3sg=3pl).
  perwaidīntun+V+Ind+Prs+Sg1+Refl:perwaidinnas # ;
  perwaidīntun+V+Ind+Prs+Sg2+Refl:perwaidinnas # ;
  perwaidīntun+V+Ind+Prs+SP3+Refl:perwaidinnas # ;
  perwaidīntun+V+Ind+Prt+Sg1+Refl:perwaidinnas # ;
  perwaidīntun+V+Ind+Prt+Sg2+Refl:perwaidinnas # ;
  perwaidīntun+V+Ind+Prt+SP3+Refl:perwaidinnas # ;

  ! Indeklinable Zehner (syntax_rules §23: bare -t-Form, Nomen trägt den Kasus;
  ! im Gebrauchskorpus YT: dwiddesimt, trīsdesimt, ketturdesimt, septinnadesimt,
  ! astōnadesimt, desimt→dessimt via norm-Layer). Ohne Twanksta-Eintrag.
  dessimt+Num:dessimt           # ; ! „zehn"
  dwiddesimt+Num:dwiddesimt     # ; ! „zwanzig"
  trīsdesimt+Num:trīsdesimt     # ; ! „dreißig"
  ketturdesimt+Num:ketturdesimt # ; ! „vierzig"
  pēnkdesimt+Num:pēnkdesimt     # ; ! „fünfzig"
  usdesimt+Num:usdesimt         # ; ! „sechzig"
  septīndesimt+Num:septīndesimt # ; ! „siebzig"
  astōndesimt+Num:astōndesimt   # ; ! „achtzig"
  newīndesimt+Num:newīndesimt   # ; ! „neunzig"

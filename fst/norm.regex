define Vowel [a|e|i|o|u|ā|ē|ī|ō|ū];

define DegemNN [n -> 0 || Vowel _ n];
define DegemMM [m -> 0 || Vowel _ m];
define DegemPP [p -> 0 || Vowel _ p];
define DegemTT [t -> 0 || Vowel _ t];
define DegemDD [d -> 0 || Vowel _ d];
define DegemKK [k -> 0 || Vowel _ k];
define DegemLL [l -> 0 || Vowel _ l];
define DegemRR [r -> 0 || Vowel _ r];
define DegemSS [s -> 0 || Vowel _ s];
define DegemBB [b -> 0 || Vowel _ b];
define DegemGG [g -> 0 || Vowel _ g];
define DegemZZ [z -> 0 || Vowel _ z];

define DegemAll DegemNN .o. DegemMM .o. DegemPP .o. DegemTT .o. DegemDD .o. DegemKK .o. DegemLL .o. DegemRR .o. DegemSS .o. DegemBB .o. DegemGG .o. DegemZZ ;

define WProthese [w -> 0 || .#. _ u];
define SamlandI [0 -> i || s t s _ .#.];

! Nom-Sg-Variante der i-Stämme: pawīstis → pawīsts (YT-Korpus)
define ISynkope [i (->) 0 || t _ s .#.];

! Diphthong-Schreibvariante ohne Makron: aī → ai (niaīnunts → niainunts)
define DiphAI [ī (->) i || a _ ];

! Generelle Makron-Verlust: ī → i (Korpusschreibung ohne Längenzeichen)
define MacronLoss [ī (->) i];

! Infinitiv-Endungsvariante: -twei ↔ -tun (dialektal, historisch)
! Achtung: {…} nötig — nacktes `twei` wäre in xfst-Regex EIN Multichar-Symbol
! und würde in der Komposition nie gegen die Einzelzeichen von base.fst matchen.
define InfTunTwei [{twei} (->) {tun} || _ .#.];

! Einzelregeln separat sichern (fuer error_classification.py: welche
! einzelne Ortho-Regel erklaert eine Korpusform, komponiert mit base.fst
! in build/rules/<name>.fst, s. Makefile).
regex DegemAll ;
save stack build/rules/degem_all.hfst
clear stack

regex WProthese ;
save stack build/rules/w_prothese.hfst
clear stack

regex SamlandI ;
save stack build/rules/samland_i.hfst
clear stack

regex ISynkope ;
save stack build/rules/i_synkope.hfst
clear stack

regex DiphAI ;
save stack build/rules/diph_ai.hfst
clear stack

regex MacronLoss ;
save stack build/rules/macron_loss.hfst
clear stack

regex InfTunTwei ;
save stack build/rules/inf_tun_twei.hfst
clear stack

regex DegemAll .o. WProthese .o. SamlandI .o. ISynkope .o. DiphAI .o. MacronLoss .o. InfTunTwei ;
save stack build/norm.hfst
quit

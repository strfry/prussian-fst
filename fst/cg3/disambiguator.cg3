# ============================================ #
# Altpreußischer Disambiguator (Nominalgruppe) #
# ============================================ #
#
# Regelreferenz: prussian-bert/docs/nominal_group_reference.md
# Ergänzend: prussian-grammar/syntax_rules.txt (Palmaitis/Nērtiks, §-Verweise;
#   Vorsicht Katechismus-Quelle — stas nur als Demonstrativ/Gen-Periphrase,
#   nie als Artikel-Calque behandeln)
#   - NG = [Gen-Modifikator] [kongruente Modifikatoren] [Kopf N/Pron]
#   - Gen-Token sind agreement-transparent
#   - Klauselgrenzen: SCnj, finite Verben; Cnj/Gen sind KEINE Grenzen
#   - Präpositionsrektion via FST-Tags GovAkk/GovDat
#   - Genitivobjekte: lexikalisch (GenVerb) + Genitivus negationis (ni + V)
#   - Verbvalenz: +GovAkk/+GovDat und +PP<prep> aus desc (gen_lexc.py)
#
# Input-Stream: fst/scripts/cg3_pipeline.py
#   "<Labban>"
#       "labs" Adj Sg Akk Fem
#   Interpunktion: CLB (./!/?) bzw. PUNCT; unbekannt: Unk

DELIMITERS = "<.>" "<!>" "<?>" ;


# ============= #
# Tags und Sets #
# ============= #

LIST N = N ;
LIST Adj = Adj ;
LIST Pron = Pron ;
LIST Num = Num ;
LIST V = V ;
LIST Part = Part ;
LIST Adv = Adv ;
LIST Prp = Prp ;
LIST Cnj = Cnj ;
LIST SCnj = SCnj ;
LIST Pcl = Pcl ;
LIST IJ = IJ ;
LIST CLB = CLB ;
LIST PUNCT = PUNCT ;
LIST Unk = Unk ;

LIST Nom = Nom ;
LIST Gen = Gen ;
LIST Dat = Dat ;
LIST Akk = Akk ;
LIST Sg = Sg ;
LIST Pl = Pl ;
LIST Masc = Masc ;
LIST Fem = Fem ;
LIST Neut = Neut ;
LIST Inf = Inf ;
LIST GovAkk = GovAkk ;
LIST GovDat = GovDat ;
LIST Psp = Psp ;
LIST GovGen = GovGen ;

LIST Ni = "ni" ;
LIST BOS = (>>>) ;                                 # Fensteranfang (magisches Tag)
# di/dis/din: enklitisches Subjektersatz-Pronomen (syntax_rules §15, FST-Tag
# +Encl) — steht direkt nach dem finiten Verb: "bilāi di"
LIST Di = (Pron Encl) ;
# Person-Tags auf Pronomina (FST +P1/+P2/+P3 aus Twanksta desc "pn 1/2/3")
LIST P1Pron = (Pron P1) ;
LIST P2Pron = (Pron P2) ;
# pastātwei verhält sich prädikativ wie būtwei (syntax_rules §9/§14:
# Prädikativ ist Neutrum, Prädikatsnomen Nominativ)
LIST Copula = "būtwei" "pastātwei" ;
# Auxiliare der analytischen Tempora (§11–§14): Partizip danach ist
# prädikativ und wird von den NG-Agreement-Filtern ausgenommen
LIST Aux = "būtwei" "pastātwei" "wīrstwei" ;
# Numeral-Substantive und Maßnomen regieren nachgestellten Genitiv
# (§22 "dwiddesimts sunnin", §28 pussis + Gen)
LIST MeasureN = "dessimts" "dwiddesimts" "trīsdesimts" "ketturdesimts"
                "pēnkdesimts" "usdesimts" "septīndesimts" "astōndesimts"
                "newīndesimts" "sīmtan" "tūsimts" "pussis" ;
# stēisan/stesse/stesses: eindeutige Gen-Formen von stas als nachgestellte
# Genitiv-Periphrase (syntax_rules §4) — lizenzieren Gen am Folgenominal
LIST GenDet = ("stas" Gen) ;

# GenVerb: kuratierte Liste der Genitiv-Verben (valence.json).
# Akk/Dat-Valenz ist jetzt tag-basiert (+GovAkk/+GovDat auf dem Verb).
INCLUDE generated-sets.cg3 ;

SET FiniteVerb = V - Inf - Part ;                 # Ind/Opt/Imp/Subj
SET ClauseBoundary = SCnj OR FiniteVerb OR CLB OR PUNCT ;

SET NGHead = N OR Pron ;
SET NonGenHead = NGHead - Gen ;                    # Gen-Köpfe sind transparent
SET CongrMod = Adj OR Num OR Part ;                # kongruente Modifikatoren
SET Nominal = N OR Adj OR Pron OR Num OR Part ;
SET NAdv = N OR Adv ;
SET AdjAdv = Adj OR Adv ;
SET AdjNum = Adj OR Num ;
SET PPMid = AdjNum OR Part OR Gen ;                # PP-Zwischenglieder
SET RightCB = SCnj OR CLB OR PUNCT ;               # Klauselgrenze ohne FiniteVerb

# Grenze der Agreement-Domäne beim Kopf-Scan nach rechts.
# Cnj ist absichtlich NICHT enthalten (transparent bei gleicher Signatur),
# Gen-Köpfe stoppen nicht (NonGenHead via HeadBarrier in den Regeln).
SET AgrBarrier = SCnj OR FiniteVerb OR Inf OR CLB OR PUNCT OR Prp OR Psp OR Pcl OR Adv OR IJ OR Unk ;
SET HeadBarrier = AgrBarrier OR NonGenHead ;

# PP-Innenraum: Scan nach links zur regierenden Präposition
SET PPStop = SCnj OR FiniteVerb OR CLB OR PUNCT OR Cnj OR Pcl OR Adv OR IJ OR Psp OR Unk ;

# ── Dependenzschicht (SECTION 8) ────────────────────────────────
# Mapping-Tags: @pred = Prädikatskern nach Aux/Kopula (übernimmt in
# UD-Manier die Kopfrolle der Klausel), @fin = finites Verb als
# Klauselkopf. Beide werden von dependency.cg3 (Label-Phase) gelesen.
LIST XPred = (@pred) ;
LIST XFin = (@fin) ;
SET ClauseHead = XPred OR XFin ;
SET Adposition = Prp OR Psp ;
# Determinierer-Pronomina (stas, kas, …): keine Personal-/Enklitika
SET DetPron = Pron - (Pron P1) - (Pron P2) - (Pron P3) - (Pron Encl) ;

# Reflexiv-Klitikon: „si" (enklitische Partikel) bzw. „sin"/„sebbei"
# (Pron+Refl, Akk/Dat).  Lizenziert die +Refl-Lesart reflexiver Verben,
# deren Klitikon der FST als eigenes Token abtrennt (gen_lexc.py: „ si").
LIST Refl = Refl ;
SET ReflMarker = ("si" Pcl) OR (Pron Refl) ;
SET NonReflV = V - Refl ;                          # nicht-reflexive Verblesart


# ============================================================ #
# BEFORE-SECTIONS — Parent-Relation für kongruente Modifikatoren #
# ============================================================ #
# Jede kongruente Modifikator-Lesart (Adj/Num/Part) bekommt als
# Parent den nächsten NGHead rechts innerhalb der Agreement-Domäne.
# Die Parent-Relation wird in SECTION 5 von den 27 SELECT-Regeln
# (generated-agreement.cg3) für die Merkmals-Abstimmung genutzt.

BEFORE-SECTIONS
SETPARENT CongrMod TO (1* NGHead BARRIER AgrBarrier) ;


# ========================================== #
# SECTION 1 — Präpositionsrektion (Doc §PP)  #
# ========================================== #

SECTION

# PP-Reichweite BEGRENZT auf Prp + max. 2 Zwischenglieder + Kopf:
# ein unbegrenzter Links-Scan läuft über den PP-Kopf hinaus und
# trifft Nachbar-NGs ("[en skūlei] pagaūsenis" → Kollaps).
# PPMid = was zwischen Präposition und Kopf stehen kann.

# Innerhalb einer PP gibt es keinen Nominativ.
REMOVE SAFE (Nom) IF (0 Nominal) (-1C Prp) ;
REMOVE SAFE (Nom) IF (0 Nominal) (-2C Prp) (-1 PPMid) ;
REMOVE SAFE (Nom) IF (0 Nominal) (-3C Prp) (-2 PPMid) (-1 PPMid) ;

# Rein Akk-regierende Präposition: kein Dativ in der PP.
REMOVE SAFE (Dat) IF (0 Nominal) (-1C Prp + GovAkk LINK NOT 0 GovDat) ;
REMOVE SAFE (Dat) IF (0 Nominal) (-2C Prp + GovAkk LINK NOT 0 GovDat) (-1 PPMid) ;
REMOVE SAFE (Dat) IF (0 Nominal) (-3C Prp + GovAkk LINK NOT 0 GovDat)
    (-2 PPMid) (-1 PPMid) ;

# Rein Dat-regierende Präposition: kein Akkusativ in der PP.
REMOVE SAFE (Akk) IF (0 Nominal) (-1C Prp + GovDat LINK NOT 0 GovAkk) ;
REMOVE SAFE (Akk) IF (0 Nominal) (-2C Prp + GovDat LINK NOT 0 GovAkk) (-1 PPMid) ;
REMOVE SAFE (Akk) IF (0 Nominal) (-3C Prp + GovDat LINK NOT 0 GovAkk)
    (-2 PPMid) (-1 PPMid) ;

# Kongruente Modifikatoren in einer Akk-PP können nicht Gen sein
# (Gen-Modifikatoren sind N/Pron; Adj-Gen nur bei folgendem Gen-Kopf).
REMOVE SAFE Adj + Gen IF (-1C Prp + GovAkk LINK NOT 0 GovDat)
    (NEGATE 1* NGHead + Gen BARRIER ClauseBoundary) ;
REMOVE SAFE Adj + Gen IF (-2C Prp + GovAkk LINK NOT 0 GovDat) (-1 PPMid)
    (NEGATE 1* NGHead + Gen BARRIER ClauseBoundary) ;


# ============================================================ #
# SECTION 1b — R1: Rektion der Doppel-Präpositionen auflösen   #
# ============================================================ #
# Der Kasus des PP-Nominals disambiguiert GovAkk|GovDat (ēn/pa/
# ezze/pō) — die Statik/Dynamik-Semantik (§7) ist dafür unnötig.

SECTION

SELECT (GovDat) IF (0 GovAkk) (1C Nominal + Dat) ;
SELECT (GovAkk) IF (0 GovDat) (1C Nominal + Akk) ;
# mit kongruentem Modifikator dazwischen: Scan auf den NG-Kopf
SELECT (GovDat) IF (0 GovAkk)
    (1* NGHead + Dat BARRIER PPStop LINK NOT 0 Akk) ;
SELECT (GovAkk) IF (0 GovDat)
    (1* NGHead + Akk BARRIER PPStop LINK NOT 0 Dat) ;


# ========================================================== #
# SECTION 2 — Regel 4 (be): Prp vs. Cnj                      #
# ========================================================== #
# Muss VOR den Kopf-Scans laufen: eine unaufgelöste Prp-Lesart
# von "be" wirkt sonst als AgrBarrier und blockiert Regel 1.

SECTION

# Gleicher Kasus unmittelbar links und rechts → Koordination,
# keine Präposition (Doc: Cnj verbindet Konstituenten gleicher Signatur).
SELECT (Cnj) IF (0 Prp) (-1 Nominal + Nom) (1 Nominal + Nom) ;
SELECT (Cnj) IF (0 Prp) (-1 Nominal + Gen) (1 Nominal + Gen) ;
SELECT (Cnj) IF (0 Prp) (-1 Nominal + Dat) (1 Nominal + Dat) ;
SELECT (Cnj) IF (0 Prp) (-1 Nominal + Akk) (1 Nominal + Akk) ;

# R2: satzinitiales / nach-Interpunktion stehendes "Be" ist Diskurs-
# Konnektor, keine Präposition.
SELECT (Cnj) IF (0 Prp) (-1 BOS) ;
SELECT (Cnj) IF (0 Prp) (-1 CLB OR PUNCT) ;

# R2: rechts folgt eine Klausel (finites Verb vor dem nächsten Nominal)
# → Koordination von Klauseln.
SELECT (Cnj) IF (0 Prp) (1* FiniteVerb BARRIER Nominal) ;

# R4b: „be" = Präposition „ohne" braucht ein Akk-Komplement rechts.
# Ist in der Klausel kein Akk-NG-Kopf erreichbar (rechts folgt Verb,
# Präposition, Adverb, Interpunktion …), kann nur die Konjunktion „und"
# vorliegen.  Fängt die Residualfälle, die die Koordinations- und
# Diskurs-Regeln oben nicht treffen.
SELECT (Cnj) IF (0 Prp) (0 Cnj)
    (NEGATE 1* NGHead + Akk BARRIER ClauseBoundary) ;


# ============================================================ #
# SECTION 2b — Parent-Refresh nach der Prp/Cnj-Auflösung       #
# ============================================================ #
# Der BEFORE-SECTIONS-SETPARENT läuft nur EINMAL — eine später
# aufgelöste Prp-Lesart (be → Cnj) hat dort als AgrBarrier den
# Kopf-Scan blockiert ("gēidras [be] … dēinas").  Dieselbe Regel
# als Sektionsregel feuert in jedem Durchlauf erneut, sobald sich
# Lesarten (und damit Barrieren) ändern.  Konjunkte (nach Cnj) sind
# ausgenommen — die hängt SECTION 8 ans erste Konjunkt (sonst
# Oszillation zwischen beiden Regeln).

SECTION

# Guard: nur echte Koordination (Cnj MIT linkem Konjunkt) ausnehmen —
# nach Diskurs-Konnektor "Be …" ist -1 zwar Cnj, aber kein Konjunkt.
SETPARENT CongrMod - XPred (NEGATE -1C Cnj LINK -1 CongrMod)
    TO (1* NGHead BARRIER AgrBarrier) ;


# ============================================================ #
# SECTION 2c — Lexikalische POS-Defaults: stwi (Adv|Pcl)       #
# ============================================================ #
# „stwi" ist zweideutig: Ortsadverb „hier/dort" (av) vs. präsentative
# Partikel „siehe, hier ist" (pcl).  Die präsentative Lesart steht am
# Satz-/Klauselanfang, das Ortsadverb sonst.

SECTION

SELECT (Pcl) IF (0 Adv) (0 Pcl) (-1 BOS) ;
SELECT (Pcl) IF (0 Adv) (0 Pcl) (-1 CLB OR PUNCT) ;
SELECT (Adv) IF (0 Adv) (0 Pcl) ;


# ==================================================== #
# SECTION 3a — Regel 1: Adj bei kongruierendem Kopf    #
# ==================================================== #




# ==================================================== #
# SECTION 3b — Adv/Prädikativ/N-Fallback (Regeln 1+2)  #
# ==================================================== #

SECTION

# Regel 2: Adv, wenn überhaupt kein Kopf rechts in Reichweite ist …
SELECT (Adv) IF (0 Adj)
    (NEGATE 1* NGHead BARRIER AgrBarrier) ;

# … und Prädikativ nach Kopula: kurze Neutrum-Sg-Form ist Adj, nicht N.
SELECT Adj + (Sg Neut) IF (0 N)
    (-1*C Copula BARRIER ClauseBoundary)
    (NEGATE 1* NGHead BARRIER AgrBarrier) ;

# Regel 1 Fallback: Adj/N-Token ohne Kopf rechts und ohne Kopula links ist N.
SELECT (N) IF (0 Adj)
    (NEGATE 1* NGHead BARRIER AgrBarrier)
    (NEGATE -1*C Copula BARRIER ClauseBoundary) ;

# R8 — Adj+IJ-Token ohne N-Kopf rechts und ohne Kopula links: Adj entfernen.
# Adjektiv braucht einen N-Kopf; ohne N-Kopf ist die IJ-Lesart die korrekte
# (Grüße "kaīls!", "kaīls wisēimans!").
# Der N-Kopf-Scan stoppt an AgrBarrier — ein N jenseits einer Klauselgrenze
# oder eines finiten Verbs zählt nicht.
REMOVE SAFE (Adj) IF (0 IJ)
    (NEGATE 1* N BARRIER AgrBarrier)
    (NEGATE -1*C Copula BARRIER ClauseBoundary) ;

# R6 — di-Impersonal (syntax_rules §15): di direkt nach finitem Verb
# ist Subjektersatz → Nominativ ("bilāi di", "mēri di").
SELECT (Nom) IF (0 Di) (-1C FiniteVerb) ;

# R3 — pēr: Partikel („zu/allzu", vor Adj/Adv) vs. Präposition (vor Akk-NG).
SELECT (Prp) IF (0 Pcl) (0 Prp)
    (1* NGHead + Akk BARRIER AgrBarrier) ;
SELECT (Pcl) IF (0 Prp) (0 Pcl) (1C AdjAdv) ;

# R7 — Prädikatives Partizip direkt nach Auxiliar (§11–§14, periphrastische
# Tempora) steht im Nominativ: oblique Lesarten der vollen Partizip-
# Deklination entfernen; Numerus vom unmittelbar davorstehenden Subjekt.
REMOVE SAFE (Akk) IF (0C Part) (-1C Aux) ;
REMOVE SAFE (Gen) IF (0C Part) (-1C Aux) ;
REMOVE SAFE (Dat) IF (0C Part) (-1C Aux) ;
REMOVE SAFE (Pl) IF (0C Part) (-1C Aux) (-2C NGHead + Sg) ;
REMOVE SAFE (Sg) IF (0C Part) (-1C Aux) (-2C NGHead + Pl) ;


# ==================================================== #
# SECTION 3c — R4: N vs. V (Doc-Regel 3)               #
# ==================================================== #

SECTION

# Klausel hat links schon ein eindeutiges finites Verb → Token ist Nominal.
SELECT Nominal IF (0 FiniteVerb) (0 Nominal)
    (-1*C FiniteVerb BARRIER ClauseBoundary) ;

# … oder rechts (vor der nächsten Klauselgrenze ohne das Verb selbst).
SELECT Nominal IF (0 FiniteVerb) (0 Nominal)
    (1*C FiniteVerb BARRIER RightCB) ;

# Eindeutige Nominativ-NG direkt links als Subjekt → Token ist Verb.
SELECT (V) IF (0 Nominal) (0 FiniteVerb)
    (-1C NGHead + Nom) ;


# ====================================================== #
# SECTION 4 — Genitiv-Lizenzierung (Doc §Gen + Regel 5)  #
# ====================================================== #

SECTION

# Genitivus negationis: nach negiertem finiten Verb ist das Akk/Gen-
# ambige Objekt Gen (produktive Regel; nicht innerhalb einer PP).
SELECT (Gen) IF (0 Akk) (0 Gen)
    (-1* FiniteVerb BARRIER ClauseBoundary LINK -1 Ni)
    (NEGATE -1*C Prp BARRIER PPStop) ;

# stēisan-Konstruktion (syntax_rules §4): nach eindeutigem Gen-Demonstrativum
# ist die Gen-Lesart des Folgenominals die nachgestellte Genitiv-Periphrase.
SELECT (Gen) IF (0 Gen) (0 Nominal - Gen) (-1C GenDet) ;

# Postposition paggan regiert den VORANGESTELLTEN Genitiv: "stesse paggan",
# "kasse paggan" — direkt vor Psp+GovGen ist die Gen-Lesart die richtige.
SELECT (Gen) IF (0 Gen) (0 Nominal - Gen) (1C Psp + GovGen) ;

# Gen-Lesarten ohne Lizenzierer entfernen: kein NG-Kopf rechts
# (Gen-Modifikator steht VOR seiner NG), kein Gen-Verb, keine Negation
# und kein Gen-Demonstrativum (stēisan) links in der Klausel; direkt nach
# Numerale kein Eingriff (Bruchzahlen regieren Gen, syntax_rules §27).
REMOVE SAFE (Gen) IF (0 Nominal - Gen)
    (NOT -1 Num) (NOT -1 MeasureN)
    (NEGATE 1* NGHead BARRIER ClauseBoundary)
    (NEGATE -1* GenVerb BARRIER ClauseBoundary)
    (NEGATE -1* GenDet BARRIER ClauseBoundary)
    (NEGATE -1* FiniteVerb BARRIER ClauseBoundary LINK -1 Ni) ;

# Kongruente Gen-Lesarten brauchen einen Gen-Kopf rechts: Gen-Modifikatoren
# sind N/Pron; ein Adj/Num/Part im Gen ist nur als Modifikator eines
# Gen-Kopfs (oder als Gen-Objekt, s. Lizenzierer oben) möglich.
REMOVE SAFE CongrMod + Gen IF (0 Nominal - Gen)
    (NOT -1 Num) (NOT -1 MeasureN)
    (NEGATE 1* NGHead + Gen BARRIER ClauseBoundary)
    (NEGATE -1* GenVerb BARRIER ClauseBoundary)
    (NEGATE -1* GenDet BARRIER ClauseBoundary)
    (NEGATE -1* FiniteVerb BARRIER ClauseBoundary LINK -1 Ni) ;


# ============================================================ #
# SECTION 4b — Parent-basierte Kasus-/Merkmalsfilter           #
# ============================================================ #
# Nutzt die Parent-Relation der kongruenten Modifikatoren: Lesarten,
# deren Merkmal in KEINER Lesart des Kopfes vorkommt, sind mit dem
# Kopf inkompatibel und fallen weg.  Deckt insbesondere den
# gēidras-Fall ab: die N+Gen-Lesart eines Adj/N-Tokens stirbt, wenn
# der Kopf (dēinas) kein Gen ist — die 27 SELECT-Regeln in SECTION 5
# greifen dort nicht, solange die Signatur nicht exakt passt.

SECTION

# gēidras-Fall explizit: Adj-Token mit N+Gen-Nebenlesart, Kopf ohne Gen.
REMOVE SAFE N + Gen IF (0 Adj) (p NGHead LINK NOT 0 Gen) ;

# Verallgemeinerung: Merkmal ohne Gegenstück im Kopf entfernen.
REMOVE SAFE (Nom)  IF (0 CongrMod) (p NGHead LINK NOT 0 Nom) ;
REMOVE SAFE (Gen)  IF (0 CongrMod) (p NGHead LINK NOT 0 Gen) ;
REMOVE SAFE (Dat)  IF (0 CongrMod) (p NGHead LINK NOT 0 Dat) ;
REMOVE SAFE (Akk)  IF (0 CongrMod) (p NGHead LINK NOT 0 Akk) ;
REMOVE SAFE (Sg)   IF (0 CongrMod) (p NGHead LINK NOT 0 Sg) ;
REMOVE SAFE (Pl)   IF (0 CongrMod) (p NGHead LINK NOT 0 Pl) ;
REMOVE SAFE (Masc) IF (0 CongrMod) (p NGHead LINK NOT 0 Masc) ;
REMOVE SAFE (Fem)  IF (0 CongrMod) (p NGHead LINK NOT 0 Fem) ;
REMOVE SAFE (Neut) IF (0 CongrMod) (p NGHead LINK NOT 0 Neut) ;


# ============================================================ #
# SECTION 5 — Agreement-Propagation in der NG (Doc §Agreement) #
# ============================================================ #
# Parent-basierte Filter (BEFORE-SECTIONS: SETPARENT CongrMod TO
# (1* NGHead BARRIER AgrBarrier)).  9 Merkmale × 3 POS = 27 Regeln.

SECTION
SELECT (Adj Masc) IF (0 Adj) (p (Masc)) ;
SELECT (Adj Fem) IF (0 Adj) (p (Fem)) ;
SELECT (Adj Neut) IF (0 Adj) (p (Neut)) ;
SELECT (Adj Nom) IF (0 Adj) (p (Nom)) ;
SELECT (Adj Gen) IF (0 Adj) (p (Gen)) ;
SELECT (Adj Dat) IF (0 Adj) (p (Dat)) ;
SELECT (Adj Akk) IF (0 Adj) (p (Akk)) ;
SELECT (Adj Sg) IF (0 Adj) (p (Sg)) ;
SELECT (Adj Pl) IF (0 Adj) (p (Pl)) ;
SELECT (Num Masc) IF (0 Num) (p (Masc)) ;
SELECT (Num Fem) IF (0 Num) (p (Fem)) ;
SELECT (Num Neut) IF (0 Num) (p (Neut)) ;
SELECT (Num Nom) IF (0 Num) (p (Nom)) ;
SELECT (Num Gen) IF (0 Num) (p (Gen)) ;
SELECT (Num Dat) IF (0 Num) (p (Dat)) ;
SELECT (Num Akk) IF (0 Num) (p (Akk)) ;
SELECT (Num Sg) IF (0 Num) (p (Sg)) ;
SELECT (Num Pl) IF (0 Num) (p (Pl)) ;
SELECT (Part Masc) IF (0 Part) (p (Masc)) ;
SELECT (Part Fem) IF (0 Part) (p (Fem)) ;
SELECT (Part Neut) IF (0 Part) (p (Neut)) ;
SELECT (Part Nom) IF (0 Part) (p (Nom)) ;
SELECT (Part Gen) IF (0 Part) (p (Gen)) ;
SELECT (Part Dat) IF (0 Part) (p (Dat)) ;
SELECT (Part Akk) IF (0 Part) (p (Akk)) ;
SELECT (Part Sg) IF (0 Part) (p (Sg)) ;
SELECT (Part Pl) IF (0 Part) (p (Pl)) ;


# ============================================== #
# SECTION 6 — Determinierer vor eindeutigem Kopf  #
# ============================================== #

SECTION

# Pronomen auf das direkt folgende NGHead abstimmen, ABER nur bei
# eindeutigem Kopf (1C = alle Lesarten des Kopfes müssen die Signatur haben).
SELECT (Sg Nom Masc) IF (0C Pron) (1C NGHead + (Sg Nom Masc)) ;
SELECT (Sg Nom Fem) IF (0C Pron) (1C NGHead + (Sg Nom Fem)) ;
SELECT (Sg Nom Neut) IF (0C Pron) (1C NGHead + (Sg Nom Neut)) ;
SELECT (Sg Gen Masc) IF (0C Pron) (1C NGHead + (Sg Gen Masc)) ;
SELECT (Sg Gen Fem) IF (0C Pron) (1C NGHead + (Sg Gen Fem)) ;
SELECT (Sg Gen Neut) IF (0C Pron) (1C NGHead + (Sg Gen Neut)) ;
SELECT (Sg Dat Masc) IF (0C Pron) (1C NGHead + (Sg Dat Masc)) ;
SELECT (Sg Dat Fem) IF (0C Pron) (1C NGHead + (Sg Dat Fem)) ;
SELECT (Sg Dat Neut) IF (0C Pron) (1C NGHead + (Sg Dat Neut)) ;
SELECT (Sg Akk Masc) IF (0C Pron) (1C NGHead + (Sg Akk Masc)) ;
SELECT (Sg Akk Fem) IF (0C Pron) (1C NGHead + (Sg Akk Fem)) ;
SELECT (Sg Akk Neut) IF (0C Pron) (1C NGHead + (Sg Akk Neut)) ;
SELECT (Pl Nom Masc) IF (0C Pron) (1C NGHead + (Pl Nom Masc)) ;
SELECT (Pl Nom Fem) IF (0C Pron) (1C NGHead + (Pl Nom Fem)) ;
SELECT (Pl Nom Neut) IF (0C Pron) (1C NGHead + (Pl Nom Neut)) ;
SELECT (Pl Gen Masc) IF (0C Pron) (1C NGHead + (Pl Gen Masc)) ;
SELECT (Pl Gen Fem) IF (0C Pron) (1C NGHead + (Pl Gen Fem)) ;
SELECT (Pl Gen Neut) IF (0C Pron) (1C NGHead + (Pl Gen Neut)) ;
SELECT (Pl Dat Masc) IF (0C Pron) (1C NGHead + (Pl Dat Masc)) ;
SELECT (Pl Dat Fem) IF (0C Pron) (1C NGHead + (Pl Dat Fem)) ;
SELECT (Pl Dat Neut) IF (0C Pron) (1C NGHead + (Pl Dat Neut)) ;
SELECT (Pl Akk Masc) IF (0C Pron) (1C NGHead + (Pl Akk Masc)) ;
SELECT (Pl Akk Fem) IF (0C Pron) (1C NGHead + (Pl Akk Fem)) ;
SELECT (Pl Akk Neut) IF (0C Pron) (1C NGHead + (Pl Akk Neut)) ;


# ====================================================== #
# SECTION 7 — R5: Verbperson bei explizitem Subjekt      #
# ====================================================== #
# Pro-drop: OHNE Pronomen bleibt die Personenambiguität stehen
# (kein P3-Default). Subjekt = nächster eindeutiger Nom-Kopf links.

LIST P1 = P1 ;
LIST P2 = P2 ;
LIST P3 = P3 ;
# P1Pron/P2Pron oben via FST-Tags definiert (+P1/+P2 auf Pron)
SET P12 = P1 OR P2 ;
SET P3SubjAny = NGHead - P1Pron - P2Pron ;
SET SubjBarrier = ClauseBoundary OR NGHead ;

SECTION

SELECT (P1 Sg) IF (0 (P1 Sg))
    (-1*C P1Pron + Nom + Sg BARRIER SubjBarrier) ;
SELECT (P1 Pl) IF (0 (P1 Pl))
    (-1*C P1Pron + Nom + Pl BARRIER SubjBarrier) ;
SELECT (P2 Sg) IF (0 (P2 Sg))
    (-1*C P2Pron + Nom + Sg BARRIER SubjBarrier) ;
SELECT (P2 Pl) IF (0 (P2 Pl))
    (-1*C P2Pron + Nom + Pl BARRIER SubjBarrier) ;

# 3. Person: Numerus vom eindeutigen Subjekt übernehmen (auch N-Subjekte).
SELECT (P3 Sg) IF (0 (P3 Sg)) (0 (P3 Pl))
    (-1*C P3SubjAny + Nom + Sg BARRIER SubjBarrier) ;
SELECT (P3 Pl) IF (0 (P3 Sg)) (0 (P3 Pl))
    (-1*C P3SubjAny + Nom + Pl BARRIER SubjBarrier) ;

# 3. Person ohne Numerus-Evidenz: nur P1/P2 abwählen.
SELECT (P3) IF (0 P12) (0 P3)
    (-1*C P3SubjAny + Nom BARRIER SubjBarrier) ;


# ============================================================ #
# SECTION 7b — Reflexiv-Doubletten (+Refl vs. non-Refl)        #
# ============================================================ #
# Der FST liefert für Verben mit reflexivem Homograph beide Lesarten
# (sergītun+V+Inf und +Inf+Refl).  Die +Refl-Lesart ist nur mit
# Reflexiv-Klitikon (si/sin/sebbei) in der Klausel lizenziert.
# Guard (0 NonReflV): nur echte Doubletten anfassen — inhärent
# reflexive Verben (perwaidinnas: nur +Refl) bleiben unangetastet.

SECTION

# Klitikon in der Klausel → reflexive Lesart wählen.
SELECT (Refl) IF (0 NonReflV) (0 Refl)
    (1* ReflMarker BARRIER ClauseBoundary) ;
SELECT (Refl) IF (0 NonReflV) (0 Refl)
    (-1* ReflMarker BARRIER ClauseBoundary) ;
# Kein Klitikon in Reichweite → nicht-reflexive Lesart.
REMOVE (Refl) IF (0 NonReflV)
    (NEGATE 1* ReflMarker BARRIER ClauseBoundary)
    (NEGATE -1* ReflMarker BARRIER ClauseBoundary) ;


# ============================================================ #
# SECTION 8 — Dependenzschicht: Syntaxbaum via SETPARENT       #
# ============================================================ #
# Läuft als letzte Sektion, wenn die Lesarten weitgehend
# disambiguiert sind.  Kopf-Konvention UD-nah: das Prädikat
# (finites Verb bzw. @pred nach Aux/Kopula) ist Klauselkopf,
# Nominale hängen daran, Adpositionen an ihrem Nominal (case),
# Kopula/Auxiliar am Prädikat (cop/aux).  Unangebundene Cohorts
# (#n->n) gelten downstream als Wurzel.  Die Label vergibt
# fst/cg3/dependency.cg3 (zweite Phase, ADDRELATION).

SECTION

# ── Mapping: Klauselköpfe markieren ──
# @pred: prädikatives Partizip direkt nach Auxiliar (R7-Adjazenz) …
ADD (@pred) Part IF (-1C FiniteVerb + Aux) ;
# … oder Prädikatsnomen/-adjektiv im Nom rechts der Kopula (§2/§9).
ADD (@pred) Nominal + Nom - Part IF (NOT 0 XPred)
    (-1*C FiniteVerb + Copula BARRIER ClauseBoundary) ;
# @fin: übrige finite Verben sind selbst Klauselkopf.
ADD (@fin) FiniteVerb IF (NOT 1C Part + XPred)
    (NEGATE 0 Copula LINK 1* XPred BARRIER ClauseBoundary) ;

# ── Aux/Kopula → Prädikat ──
SETPARENT FiniteVerb - XFin TO (1* XPred BARRIER RightCB) ;

# ── Koordination: zweites Konjunkt → erstes, Cnj → zweites ──
SETPARENT CongrMod - XPred (-1C Cnj) TO (-2 CongrMod) ;
SETPARENT NGHead - Gen (-1C Cnj) TO (-2 NGHead) ;
SETPARENT Cnj (-1 Nominal) TO (1 Nominal) ;
SETPARENT Cnj (NOT p (*)) TO (1* ClauseHead BARRIER CLB) ;

# ── Subjunktion → Kopf der eingeleiteten Klausel; deren Verb
#    hängt am Matrixverb (advcl) ──
SETPARENT SCnj TO (1* ClauseHead BARRIER CLB) ;
SETPARENT ClauseHead (c SCnj) TO (-1* ClauseHead BARRIER CLB) ;

# ── Adpositionen → Kopf-Nominal ihrer Phrase (case) ──
SETPARENT Prp TO (1* NGHead BARRIER PPStop) ;
SETPARENT Psp TO (-1* NGHead BARRIER PPStop) ;

# ── Genitiv-Modifikatoren ──
# Gen-Demonstrativum der stēisan-Periphrase → folgender Gen-Kopf (det)
SETPARENT GenDet TO (1 NGHead + Gen) ;
# pränominal: Gen-Modifikator → nächster Nicht-Gen-Kopf rechts (nmod);
# NEGATE: nur echte GenDet-Periphrasen (stēisan + Gen-Kopf) ausnehmen
SETPARENT NGHead + Gen - XPred (NEGATE 0 GenDet LINK 1 NGHead + Gen)
    TO (1* NGHead - Gen BARRIER AgrBarrier) ;
# postnominal (stēisan-Periphrase): Gen-Kopf → Nominal links (nmod)
SETPARENT NGHead + Gen - XPred (NOT p (*)) (-1C GenDet)
    TO (-2* NGHead - Gen BARRIER AgrBarrier) ;

# ── Determinierer-Pronomen → direkt folgender Kopf (det) ──
SETPARENT DetPron - Gen (NOT 0 XPred) TO (1 NGHead) ;

# ── NG-Köpfe → Klauselkopf (nsubj/obj/iobj/obl, Label in Phase 2);
#    echte Konjunkte (Cnj mit linkem NG-Konjunkt) und Determinierer
#    sind schon angebunden ──
SETPARENT NGHead - Gen - XPred (NEGATE -1C Cnj LINK -1 NGHead)
    (NEGATE 0 DetPron LINK 1 NGHead)
    TO (1* ClauseHead BARRIER RightCB) ;
SETPARENT NGHead - Gen - XPred (NEGATE -1C Cnj LINK -1 NGHead)
    (NOT p ClauseHead) (NEGATE 0 DetPron LINK 1 NGHead)
    TO (-1* ClauseHead BARRIER RightCB) ;
# Gen-Objekte (GenVerb/Genitivus negationis) und obliques Gen+Psp
# ("stesse paggan"): noch ohne Parent → Klauselkopf, erst links,
# dann rechts
SETPARENT NGHead + Gen - XPred (NOT p (*))
    TO (-1* ClauseHead BARRIER RightCB) ;
SETPARENT NGHead + Gen - XPred (NOT p (*))
    TO (1* ClauseHead BARRIER RightCB) ;

# ── Adverbien, Partikeln, Infinitive ──
SETPARENT Adv TO (-1* ClauseHead BARRIER RightCB) ;
SETPARENT Adv (NOT p ClauseHead) TO (1* ClauseHead BARRIER RightCB) ;
SETPARENT Pcl TO (1C AdjAdv) ;
SETPARENT Pcl (NOT p (*)) TO (1* ClauseHead BARRIER RightCB) ;
SETPARENT Pcl (NOT p (*)) TO (-1* ClauseHead BARRIER RightCB) ;
SETPARENT Inf TO (-1* ClauseHead BARRIER RightCB) ;
SETPARENT Inf (NOT p (*)) TO (1* ClauseHead BARRIER RightCB) ;

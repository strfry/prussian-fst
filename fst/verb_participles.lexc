! Participle declension — hand-written paradigms.
!
! Three participles, each declining like an adjective:
!   present-active (≈ P29)   past-active (≈ P68)   passive (≈ P69, hard t-stem)
!
! Each lemma contributes ONE citation (long / barytone) stem per participle,
! listed in verb_stems.lexc (generated from twanksta_entries.json).
! The stem entry routes to the paradigm matching the lemma's accent class:
!
!   …Mob   mobile stress: the strong cells (Dat-Pl, Fem-Nom-Sg; passive also
!          Nom-Pl) carry the DEAC trigger, so stress.twolc de-accents the stem
!          there (aikānt+DEAC+ī → aikantī, aikāt+DEAC+āi → aikatāi).
!   …Bar   barytone stress: the same cells take the weak ending and the stem
!          keeps its accent (absōrbint+i → absōrbinti).
!
! The past-active participle has a single invariant stem (no accent shift).
! See docs/FST_PARTICIPLES.md.

! ── Past-active (P68): one invariant stem, uniform weak endings ──────────────
LEXICON PtcpPast
  +Masc+Sg+Nom:uns      # ;
  +Masc+Sg+Gen:ušas     # ;
  +Masc+Sg+Dat:ušasmu   # ;
  +Masc+Sg+Akk:usin     # ;
  +Masc+Pl+Nom:usis     # ;
  +Masc+Pl+Gen:usin     # ;
  +Masc+Pl+Dat:usimans  # ;
  +Masc+Pl+Akk:usins    # ;
  +Fem+Sg+Nom:usi       # ;
  +Fem+Sg+Gen:ušas      # ;
  +Fem+Sg+Dat:ušai      # ;
  +Fem+Sg+Akk:usin      # ;
  +Fem+Pl+Nom:ušas      # ;
  +Fem+Pl+Gen:usin      # ;
  +Fem+Pl+Dat:usimans   # ;
  +Fem+Pl+Akk:usins     # ;
  +Neut+Sg+Nom:us       # ;
  +Neut+Sg+Gen:ušas     # ;
  +Neut+Sg+Dat:ušasmu   # ;
  +Neut+Sg+Akk:us       # ;
  +Neut+Pl+Nom:us       # ;
  +Neut+Pl+Gen:usin     # ;
  +Neut+Pl+Dat:usimans  # ;
  +Neut+Pl+Akk:usins    # ;

! ── Present-active (P29) ─────────────────────────────────────────────────────
! Strong cells (mobile → DEAC): Masc/Neut-Dat-Pl, Fem-Nom-Sg, Fem-Dat-Pl.
LEXICON PtcpPresMob
  +Masc+Sg+Nom:s          # ;
  +Masc+Sg+Gen:is         # ;
  +Masc+Sg+Dat:ismu       # ;
  +Masc+Sg+Akk:in         # ;
  +Masc+Pl+Nom:ei         # ;
  +Masc+Pl+Gen:in         # ;
  +Masc+Pl+Dat:DEACimmans # ;
  +Masc+Pl+Akk:ins        # ;
  +Fem+Sg+Nom:DEACī       # ;
  +Fem+Sg+Gen:es          # ;
  +Fem+Sg+Dat:ei          # ;
  +Fem+Sg+Akk:in          # ;
  +Fem+Pl+Nom:es          # ;
  +Fem+Pl+Gen:in          # ;
  +Fem+Pl+Dat:DEACāmans   # ;
  +Fem+Pl+Akk:ins         # ;
  +Neut+Sg+Nom:i          # ;
  +Neut+Sg+Gen:is         # ;
  +Neut+Sg+Dat:ismu       # ;
  +Neut+Sg+Akk:i          # ;
  +Neut+Pl+Nom:ei         # ;
  +Neut+Pl+Gen:in         # ;
  +Neut+Pl+Dat:DEACimmans # ;
  +Neut+Pl+Akk:ins        # ;

LEXICON PtcpPresBar
  +Masc+Sg+Nom:s        # ;
  +Masc+Sg+Gen:is       # ;
  +Masc+Sg+Dat:ismu     # ;
  +Masc+Sg+Akk:in       # ;
  +Masc+Pl+Nom:ei       # ;
  +Masc+Pl+Gen:in       # ;
  +Masc+Pl+Dat:imans    # ;
  +Masc+Pl+Akk:ins      # ;
  +Fem+Sg+Nom:i         # ;
  +Fem+Sg+Gen:es        # ;
  +Fem+Sg+Dat:ei        # ;
  +Fem+Sg+Akk:in        # ;
  +Fem+Pl+Nom:es        # ;
  +Fem+Pl+Gen:in        # ;
  +Fem+Pl+Dat:amans     # ;
  +Fem+Pl+Akk:ins       # ;
  +Neut+Sg+Nom:i        # ;
  +Neut+Sg+Gen:is       # ;
  +Neut+Sg+Dat:ismu     # ;
  +Neut+Sg+Akk:i        # ;
  +Neut+Pl+Nom:ei       # ;
  +Neut+Pl+Gen:in       # ;
  +Neut+Pl+Dat:imans    # ;
  +Neut+Pl+Akk:ins      # ;

! ── Passive (P69, hard t-stem) ───────────────────────────────────────────────
! Strong cells (mobile → DEAC): Masc/Neut-Nom-Pl & Dat-Pl, Fem-Nom-Sg & Dat-Pl.
LEXICON PtcpPassMob
  +Masc+Sg+Nom:s          # ;
  +Masc+Sg+Gen:as         # ;
  +Masc+Sg+Dat:asmu       # ;
  +Masc+Sg+Akk:an         # ;
  +Masc+Pl+Nom:DEACāi     # ;
  +Masc+Pl+Gen:an         # ;
  +Masc+Pl+Dat:DEACammans # ;
  +Masc+Pl+Akk:ans        # ;
  +Fem+Sg+Nom:DEACā       # ;
  +Fem+Sg+Gen:as          # ;
  +Fem+Sg+Dat:ai          # ;
  +Fem+Sg+Akk:an          # ;
  +Fem+Pl+Nom:as          # ;
  +Fem+Pl+Gen:an          # ;
  +Fem+Pl+Dat:DEACāmans   # ;
  +Fem+Pl+Akk:ans         # ;
  +Neut+Sg+Nom:an         # ;
  +Neut+Sg+Gen:as         # ;
  +Neut+Sg+Dat:asmu       # ;
  +Neut+Sg+Akk:an         # ;
  +Neut+Pl+Nom:DEACāi     # ;
  +Neut+Pl+Gen:an         # ;
  +Neut+Pl+Dat:DEACammans # ;
  +Neut+Pl+Akk:ans        # ;

LEXICON PtcpPassBar
  +Masc+Sg+Nom:s        # ;
  +Masc+Sg+Gen:as       # ;
  +Masc+Sg+Dat:asmu     # ;
  +Masc+Sg+Akk:an       # ;
  +Masc+Pl+Nom:ai       # ;
  +Masc+Pl+Gen:an       # ;
  +Masc+Pl+Dat:amans    # ;
  +Masc+Pl+Akk:ans      # ;
  +Fem+Sg+Nom:a         # ;
  +Fem+Sg+Gen:as        # ;
  +Fem+Sg+Dat:ai        # ;
  +Fem+Sg+Akk:an        # ;
  +Fem+Pl+Nom:as        # ;
  +Fem+Pl+Gen:an        # ;
  +Fem+Pl+Dat:amans     # ;
  +Fem+Pl+Akk:ans       # ;
  +Neut+Sg+Nom:an       # ;
  +Neut+Sg+Gen:as       # ;
  +Neut+Sg+Dat:asmu     # ;
  +Neut+Sg+Akk:an       # ;
  +Neut+Pl+Nom:ai       # ;
  +Neut+Pl+Gen:an       # ;
  +Neut+Pl+Dat:amans    # ;
  +Neut+Pl+Akk:ans      # ;

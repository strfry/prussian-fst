! ============================================================
! NOUNS — STEM + ENDING
! ============================================================

! Paradigm 32 — wīrs (masc o-stem: stem = lemma - "s")
LEXICON N32_sg
  +Sg+Nom+Masc:s      # ;
  +Sg+Gen+Masc:as     # ;
  +Sg+Dat+Masc:u      # ;
  +Sg+Akk+Masc:an     # ;
LEXICON N32_pl
  +Pl+Nom+Masc:ai     # ;
  +Pl+Gen+Masc:an     # ;
  +Pl+Dat+Masc:amans  # ;
  +Pl+Akk+Masc:ans    # ;

! Paradigm 34 — aliskans (masc n-stem: stem = lemma - "ans")
LEXICON N34_sg
  +Sg+Nom+Masc:ans    # ;
  +Sg+Gen+Masc:nas    # ;
  +Sg+Dat+Masc:nu     # ;
  +Sg+Akk+Masc:nan    # ;
LEXICON N34_pl
  +Pl+Nom+Masc:nai    # ;
  +Pl+Gen+Masc:nan    # ;
  +Pl+Dat+Masc:namans # ;
  +Pl+Akk+Masc:nans   # ;

! Paradigm 35 — mīstan (neut o-stem: stem = lemma - "an")
LEXICON N35_sg
  +Sg+Nom+Neut:an     # ;
  +Sg+Gen+Neut:as     # ;
  +Sg+Dat+Neut:u      # ;
  +Sg+Akk+Neut:an     # ;
LEXICON N35_pl
  +Pl+Nom+Neut:āi     # ;
  +Pl+Gen+Neut:an     # ;
  +Pl+Dat+Neut:amans  # ;
  @P.standard.twanksta@+Pl+Dat+Neut:amans   # ;  ! Twan: mīstamans
  ! Prus default with gemination handled inline:
  ! Prus Dat pl = mistammans — gemination must be in stem
  +Pl+Akk+Neut:ans    # ;

! Paradigm 36 — wāiks (masc ja-stem: sg stem = lemma-"s", pl stem shorter)

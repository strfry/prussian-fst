! Numerals — full forms

LEXICON Numerals
  Num22_stems ;
  Num23_stems ;
  Num24_stems ;

! 22 — abbai (both, dual)
LEXICON Num22_stems
  abbai+Num+Pl+Nom+Masc:abbai      # ;
  abbai+Num+Pl+Gen+Masc:abbejan    # ;
  abbai+Num+Pl+Dat+Masc:abbeimas   # ;
  abbai+Num+Pl+Akk+Masc:abbans     # ;
  abbai+Num+Pl+Nom+Fem:abbai       # ;
  abbai+Num+Pl+Gen+Fem:abbejan     # ;
  abbai+Num+Pl+Dat+Fem:abbeimas    # ;
  abbai+Num+Pl+Akk+Fem:abbans      # ;

! 23 — dwāi (two)
LEXICON Num23_stems
  dwāi+Num+Pl+Nom+Masc:dwāi       # ;
  dwāi+Num+Pl+Gen+Masc:dwejjan    # ;
  dwāi+Num+Pl+Dat+Masc:dwēimas    # ;
  dwāi+Num+Pl+Akk+Masc:dwāi       # ;
  dwāi+Num+Pl+Nom+Fem:dwāi        # ;
  dwāi+Num+Pl+Gen+Fem:dwejjan     # ;
  dwāi+Num+Pl+Dat+Fem:dwēimas     # ;
  dwāi+Num+Pl+Akk+Fem:dwāi        # ;

! 24 — trīs (three)
LEXICON Num24_stems
  trīs+Num+Pl+Nom+Masc:trīs       # ;
  trīs+Num+Pl+Gen+Masc:trijjan    # ;
  trīs+Num+Pl+Dat+Masc:trimmans   # ;
  trīs+Num+Pl+Akk+Masc:trins      # ;
  trīs+Num+Pl+Nom+Fem:trīs        # ;
  trīs+Num+Pl+Gen+Fem:trijjan     # ;
  trīs+Num+Pl+Dat+Fem:trimmans    # ;
  trīs+Num+Pl+Akk+Fem:trins       # ;

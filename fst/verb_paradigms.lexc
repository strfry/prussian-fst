  +Pret+P2+Sg:krīksti  # ;
  +Pret+P3+Sg:krīksti  # ;
  +Pret+P1+Pl:mai  # ;
  +Pret+P2+Pl:tei  # ;
  +Pret+P3+Pl:krīksti  # ;

! 81d — skestun (present) stem='skett'
LEXICON V81d_pres
  +Pres+P1+Sg:e  # ;
  +Pres+P2+Sg:e  # ;
  +Pres+P3+Sg:e  # ;
  +Pres+P1+Pl:imai  # ;
  +Pres+P2+Pl:itei  # ;
  +Pres+P3+Pl:e  # ;

! 81d — skestun (preterite) stem='skīti'
LEXICON V81d_pret
  +Pret+P1+Sg:skīti  # ;
  +Pret+P2+Sg:skīti  # ;
  +Pret+P3+Sg:skīti  # ;
  +Pret+P1+Pl:mai  # ;
  +Pret+P2+Pl:tei  # ;
  +Pret+P3+Pl:skīti  # ;


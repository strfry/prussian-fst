! Verb paradigm endings — STEM + ENDING decomposition.
! Bare stem on lower side from verb_stems.lexc, endings added here.

! 71 — īmtun (present) stem='imm'
LEXICON V71_pres
  +Pres+P1+Sg:a  # ;
  +Pres+P2+Sg:a  # ;
  +Pres+P3+Sg:a  # ;
  +Pres+P1+Pl:imai  # ;
  @P.standard.twanksta@+Pres+P1+Pl:amai  # ;
  +Pres+P2+Pl:itei  # ;
  @P.standard.twanksta@+Pres+P2+Pl:atei  # ;
  +Pres+P3+Pl:a  # ;

! 71 — īmtun (preterite) stem='immi'

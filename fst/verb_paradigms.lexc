  +Pret+P2+Sg:immi  # ;
  +Pret+P3+Sg:immi  # ;
  +Pret+P1+Pl:mai  # ;
  +Pret+P2+Pl:tei  # ;
  +Pret+P3+Pl:immi  # ;


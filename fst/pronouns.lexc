! Pronouns — full forms for all pronoun paradigms
! Handwritten because the Twanksta JSON lacks declension data for most pronouns.

! ── P9 — kas ─────────────────────────────────────
LEXICON Pronouns
  P9_stems ;
  P10_stems ;
  P11_stems ;
  P12_stems ;
  P13_stems ;
  P14_stems ;
  P15_stems ;
  P16_stems ;
  P17_stems ;
  P18_stems ;
  P19_stems ;
  P20_stems ;
  P21_stems ;
  P3_stems ;


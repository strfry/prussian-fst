! ============================================================
! STEM ENTRIES
! ============================================================

! 3 — reflexive
LEXICON P3_stems
  swais+Pron:sw  P3 ;

! 9 — kas
LEXICON P9_stems
  kas+Pron:k  P9 ;
  nika+Pron+Sg+Nom+Masc:nika  # ;
  nika+Pron:nik  P9 ;

! 10 — dis
LEXICON P10_stems
  di+Pron:d  P10 ;
  dis+Pron:d  P10 ;

! 11 — stas
LEXICON P11_stems
  stas+Pron:st  P11 ;

! 12 — tāns
LEXICON P12_stems

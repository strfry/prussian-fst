! Pronouns — stem+ending paradigms (P9-P21) + reflexive (P3)

LEXICON Pronouns
  P3_stems ;
  P9_stems ;
  P10_stems ;
  P11_stems ;
  P12_stems ;
  P13_stems ;
  P14_stems ;
  P15_stems ;
  P16_stems ;
  P17_stems ;
  P18_stems ;
  P19_stems ;
  P20_stems ;
  P21_stems ;


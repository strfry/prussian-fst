! Function words — handwritten
! Conjunctions, prepositions, adverbs, particles, interjections

LEXICON FunctionWords
  Conjunctions ;
  Prepositions ;
  Adverbs ;
  Particles ;
  Interjections ;

! ── Conjunctions ───────────────────────────────────
LEXICON Conjunctions
  be+Conj+Sg+Nom:be            # ;
  adder+Conj+Sg+Nom:adder      # ;
  kaddan+Conj+Sg+Nom:kaddan    # ;
  anga+Conj+Sg+Nom:anga        # ;
  angā+Conj+Sg+Nom:angā        # ;
  kwei+Conj+Sg+Nom:kwei        # ;
  jaī+Conj+Sg+Nom:jaī          # ;
  nī+Conj+Sg+Nom:nī            # ;
  beggi+Conj+Sg+Nom:beggi      # ;
  paggan+Conj+Sg+Nom:paggan    # ;

! ── Prepositions ───────────────────────────────────
LEXICON Prepositions
  en+Prep:en             # ;
  ezze+Prep:ezze         # ;
  prei+Prep:prei         # ;
  sen+Prep:sen           # ;
  iz+Prep:iz             # ;
  per+Prep:per           # ;
  pirzda+Prep:pirzda     # ;
  no+Prep:no             # ;
  pas+Prep:pas           # ;
  pō+Prep:pō             # ;
  prikki+Prep:prikki     # ;
  sīndru+Prep:sīndru     # ;
  na+Prep:na             # ;
  kīrsa+Prep:kīrsa       # ;

! ── Adverbs ────────────────────────────────────────
LEXICON Adverbs
  teinū+Adv:teinū         # ;
  tēt+Adv:tēt             # ;
  kāi+Adv:kāi             # ;
  kāigi+Adv:kāigi         # ;
  stwen+Adv:stwen         # ;
  mazzi+Adv:mazzi         # ;
  jāu+Adv:jāu             # ;
  dīgi+Adv:dīgi           # ;
  tīt+Adv:tīt             # ;
  pirmai+Adv:pirmai       # ;
  ankstāinai+Adv:ankstāinai # ;
  stawīdan+Adv:stawīdan   # ;
  labbai+Adv:labbai       # ;
  wissan+Adv:wissan       # ;
  aīnan+Adv:aīnan         # ;
  nīkadan+Adv:nīkadan     # ;
  ainunt+Adv:ainunt       # ;
  nū+Adv:nū               # ;
  staddan+Adv:staddan     # ;
  sindan+Adv:sindan       # ;
  werdāi+Adv:werdāi       # ;
  tūlan+Adv:tūlan         # ;
  biskin+Adv:biskin       # ;
  warā+Adv:warā           # ;
  rūkin+Adv:rūkin         # ;
  ikāigi+Adv:ikāigi       # ;
  pastipai+Adv:pastipai   # ;
  pastāi+Adv:pastāi       # ;
  assamai+Adv:assamai     # ;
  asmai+Adv:asmai         # ;
  ainawīdai+Adv:ainawīdai # ;
  prābūtiskai+Adv:prābūtiskai # ;
  preilīnkun+Adv:preilīnkun # ;
  waira+Adv:waira         # ;
  iz+Adv:iz               # ;
  dabber+Adv:dabber       # ;
  tēr+Adv:tēr             # ;
  ik+Adv:ik               # ;
  angāi+Adv:angāi         # ;
  stwi+Adv:stwi           # ;

! ── Particles ──────────────────────────────────────
LEXICON Particles
  ni+Part+Neg:ni          # ;
  si+Part+Refl:si         # ;
  bēi+Part+Past:bēi       # ;

! ── Interjections ─────────────────────────────────
LEXICON Interjections
  jā+IJ:jā               # ;
  jai+IJ:jai             # ;
  ahā+IJ:ahā             # ;
  aha+IJ:aha             # ;
  laukstīt+IJ:laukstīt   # ;
  ērdiw+IJ:ērdiw         # ;
  labbāi+IJ:labbāi       # ;
  kaīls+IJ:kaīls         # ;
  dīnkun+IJ:dīnkun       # ;
  wesselin+IJ:wesselin   # ;
